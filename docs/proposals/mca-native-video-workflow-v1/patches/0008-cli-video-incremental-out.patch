+// ---------------------------------------------------------------------------------------------
+// Incremental (streaming) vid_gen output: --video-incremental-out <dir>
+//
+// Every frame the library hands to the sink is encoded to frame_%05lld.png and written to disk
+// inside the callback, then released by the library as soon as the callback returns. No frame
+// array is accumulated, so peak memory is one decoded frame (plus the encoder).
+// ---------------------------------------------------------------------------------------------
+struct IncrementalVideoOutput {
+    std::string dir;
+    int64_t frames = 0;
+    std::string first_frame;
+    std::string last_frame;
+    std::vector<std::string> written;  // for cleanup when a later frame fails
+};
+
+static bool video_frame_sink_write_png(void* user, const sd_image_t* frame, int64_t frame_index) {
+    auto* out = static_cast<IncrementalVideoOutput*>(user);
+    if (out == nullptr || frame == nullptr || frame->data == nullptr) {
+        LOG_ERROR("incremental video: frame %lld is empty", (long long)frame_index);
+        return false;
+    }
+
+    char name[64];
+    snprintf(name, sizeof(name), "frame_%05lld.png", (long long)frame_index);
+    const fs::path final_path = fs::path(out->dir) / name;
+    // Write to a temporary name that still carries the .png extension (the encoder picks the
+    // format from the extension), then rename so a partially written PNG is never left behind.
+    fs::path tmp_path = fs::path(out->dir) / (std::string(".") + name + ".tmp.png");
+
+    if (!write_image_to_file(tmp_path.string(),
+                             frame->data,
+                             static_cast<int>(frame->width),
+                             static_cast<int>(frame->height),
+                             static_cast<int>(frame->channel))) {
+        LOG_ERROR("incremental video: failed to write '%s'", tmp_path.string().c_str());
+        std::error_code ignored;
+        fs::remove(tmp_path, ignored);
+        return false;
+    }
+
+    std::error_code ec;
+    fs::rename(tmp_path, final_path, ec);
+    if (ec) {
+        LOG_ERROR("incremental video: failed to move '%s' to '%s': %s",
+                  tmp_path.string().c_str(),
+                  final_path.string().c_str(),
+                  ec.message().c_str());
+        std::error_code ignored;
+        fs::remove(tmp_path, ignored);
+        return false;
+    }
+
+    if (out->frames == 0) {
+        out->first_frame = final_path.string();
+    }
+    out->last_frame = final_path.string();
+    out->written.push_back(final_path.string());
+    ++out->frames;
+    return true;
+}
+
+// Returns 0 on success, 1 on failure (partial files removed).
+static int generate_video_incrementally(SDCliParams& cli_params,
+                                        sd_ctx_t* sd_ctx,
+                                        const sd_vid_gen_params_t* vid_gen_params) {
+    const std::string& out_dir = cli_params.video_incremental_out;
+    std::error_code ec;
+    if (fs::exists(out_dir, ec)) {
+        if (!fs::is_directory(out_dir, ec)) {
+            LOG_ERROR("incremental video: '%s' exists and is not a directory", out_dir.c_str());
+            return 1;
+        }
+    } else {
+        if (!fs::create_directories(out_dir, ec) || ec) {
+            LOG_ERROR("incremental video: cannot create '%s': %s", out_dir.c_str(), ec.message().c_str());
+            return 1;
+        }
+        LOG_VERBOSE("incremental video: created directory '%s'", out_dir.c_str());
+    }
+
+    IncrementalVideoOutput out;
+    out.dir = out_dir;
+
+    int64_t num_frames = 0;
+    sd_audio_t* audio  = nullptr;
+    const bool ok      = generate_video_streaming(sd_ctx,
+                                                  vid_gen_params,
+                                                  video_frame_sink_write_png,
+                                                  &out,
+                                                  &num_frames,
+                                                  &audio);
+    const bool had_audio = (audio != nullptr);
+    free_sd_audio(audio);
+
+    // Abort + cleanup only on a real failure, or when nothing at all was produced. A run that
+    // delivered frames and reported success keeps its files (device run 98a: five frames had been
+    // written, yet the old check treated the intentionally empty frame array as an error).
+    if (!ok || num_frames <= 0) {
+        size_t removed = 0;
+        for (const auto& path : out.written) {
+            std::error_code rm_ec;
+            if (fs::remove(path, rm_ec) && !rm_ec) {
+                ++removed;
+            }
+        }
+        LOG_ERROR("incremental video: stream %s (%lld frame(s)); removed %zu partial file(s) from '%s'",
+                  ok ? "produced no frames" : "aborted",
+                  (long long)out.frames,
+                  removed,
+                  out_dir.c_str());
+        return 1;
+    }
+
+    if (had_audio) {
+        LOG_WARN("incremental video: audio output is not written in incremental mode");
+    }
+
+    printf("incremental video: frames=%lld out=%s first_frame=%s last_frame=%s\n",
+           (long long)num_frames,
+           out_dir.c_str(),
+           out.first_frame.empty() ? "-" : out.first_frame.c_str(),
+           out.last_frame.empty() ? "-" : out.last_frame.c_str());
+    fflush(stdout);
+    return 0;
+}
