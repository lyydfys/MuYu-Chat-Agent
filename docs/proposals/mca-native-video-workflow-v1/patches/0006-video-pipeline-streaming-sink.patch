@@ -0,0 +1,37 @@
+#ifndef __SD_PIPELINE_VIDEO_STREAM_RESULT_H__
+#define __SD_PIPELINE_VIDEO_STREAM_RESULT_H__
+
+#include <cstdint>
+
+namespace sd::pipeline {
+
+// Outcome of decoding one video.
+//
+// The legacy path returns a whole-video sd_image_t array; the streaming path delivers frames to a
+// sink and never builds that array, so `frames_out` stays null while the run is perfectly healthy.
+struct VideoDecodeOutcome {
+    bool has_array           = false;  // legacy path produced an array (frames_out != nullptr)
+    bool streamed            = false;  // frames were delivered incrementally (no array by design)
+    bool aborted             = false;  // consumer rejected a frame, or cancellation hit
+    int64_t delivered_frames = 0;      // frames accepted by the consumer
+};
+
+// A decode succeeded when nothing aborted it and it produced something usable: either the legacy
+// array, or at least one incrementally delivered frame.
+//
+// This is the rule the streaming path was missing on device: five delivered frames with no abort
+// must count as success even though `frames_out` stayed null (device run 98a reported
+// "stream aborted after 5 frame(s)" while all five frames had in fact been written).
+inline bool video_decode_succeeded(const VideoDecodeOutcome& outcome) {
+    if (outcome.aborted) {
+        return false;
+    }
+    if (outcome.has_array) {
+        return true;
+    }
+    return outcome.delivered_frames > 0;
+}
+
+}  // namespace sd::pipeline
+
+#endif  // __SD_PIPELINE_VIDEO_STREAM_RESULT_H__
