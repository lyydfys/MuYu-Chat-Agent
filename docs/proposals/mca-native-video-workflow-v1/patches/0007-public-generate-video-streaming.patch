@@ -524,6 +524,29 @@ SD_API bool generate_video(sd_ctx_t* sd_ctx,
                            int* num_frames_out,
                            sd_audio_t** audio_out);
 
+// Incremental video frame consumer.
+//
+// `frame` points at one decoded frame and is only valid for the duration of the call.
+// `frame_index` is the global 0-based frame number in output order.
+// Returning false aborts generation; no partial result is published.
+typedef bool (*sd_video_frame_sink_t)(void* sink_user,
+                                      const sd_image_t* frame,
+                                      int64_t frame_index);
+
+// Same generation as generate_video(), but every decoded frame is passed to `sink` in output
+// order instead of being accumulated into a single sd_image_t array.
+//
+// `num_frames_out` receives the number of frames delivered before returning.
+// `audio_out` behaves as in generate_video() and must be freed by the caller.
+// generate_video() keeps its original contract; this entry point exists so callers can encode or
+// stream frames without holding all RGB frames at once.
+SD_API bool generate_video_streaming(sd_ctx_t* sd_ctx,
+                                     const sd_vid_gen_params_t* sd_vid_gen_params,
+                                     sd_video_frame_sink_t sink,
+                                     void* sink_user,
+                                     int64_t* num_frames_out,
+                                     sd_audio_t** audio_out);
+
 typedef struct upscaler_ctx_t upscaler_ctx_t;
 
