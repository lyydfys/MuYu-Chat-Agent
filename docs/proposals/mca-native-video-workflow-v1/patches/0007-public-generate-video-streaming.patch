# Source: include/stable-diffusion.h, src/stable-diffusion.cpp
# Change: export generate_video_streaming(...) plus the sd_video_frame_sink_t callback type; it reuses the pipeline with a sink and returns the delivered frame count.
# Why:    The JNI shim libmca_wan.so imports generate_video_streaming (verified in --dyn-syms), so the app cannot stream frames without this public ABI entry point.
diff --git a/include/stable-diffusion.h b/include/stable-diffusion.h
