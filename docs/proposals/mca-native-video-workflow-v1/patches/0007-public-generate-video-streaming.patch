     return sd::pipeline::generate_video(sd_ctx->sd, sd_vid_gen_params, frames_out, num_frames_out, audio_out);
 }
 
+SD_API bool generate_video_streaming(sd_ctx_t* sd_ctx,
+                                     const sd_vid_gen_params_t* sd_vid_gen_params,
+                                     sd_video_frame_sink_t sink,
+                                     void* sink_user,
+                                     int64_t* num_frames_out,
+                                     sd_audio_t** audio_out) {
+    if (num_frames_out != nullptr) {
+        *num_frames_out = 0;
+    }
+    if (audio_out != nullptr) {
+        *audio_out = nullptr;
+    }
+    if (sd_ctx == nullptr || sd_ctx->sd == nullptr || sd_vid_gen_params == nullptr || sink == nullptr) {
+        return false;
+    }
+
+    StableDiffusionGGML::ExecutionScope execution(*sd_ctx->sd);
+    if (!execution.ready) {
+        return false;
+    }
+
+    // Frames are handed to the sink as each temporal tile finishes decoding; the pipeline never
+    // builds the whole-video frame array on this path.
+    int64_t delivered = 0;
+    const bool ok     = sd::pipeline::generate_video(sd_ctx->sd,
+                                                 sd_vid_gen_params,
+                                                 /*frames_out*/ nullptr,
+                                                 /*num_frames_out*/ nullptr,
+                                                 audio_out,
+                                                 sink,
+                                                 sink_user,
+                                                 &delivered);
+    if (num_frames_out != nullptr) {
+        *num_frames_out = delivered;
+    }
+    return ok;
+}
