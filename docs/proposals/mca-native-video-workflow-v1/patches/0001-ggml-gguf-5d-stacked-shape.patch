# Source: ggml/src/gguf.cpp (HappyYzy ggml f8758628270072da26ad44baf5e189d4695d9800)
# Change: accept GGUF tensor shapes above 4D and fold the surplus dimensions into ne[3] (ggml[in,out,kw,kh] layout) instead of aborting the tensor scan.
# Why:    Wan2.2-TI2V-5B Q4_0 stores patch_embedding.weight as a 5D tensor; pristine gguf.cpp rejects n_dims > GGML_MAX_DIMS(x4) with ok=false, so the model cannot be loaded at all.
diff --git a/ggml/src/gguf.cpp b/ggml/src/gguf.cpp
index 144a8ed..0974e05 100644
--- a/ggml/src/gguf.cpp
+++ b/ggml/src/gguf.cpp
@@ -668,25 +668,38 @@ static struct gguf_context * gguf_init_from_reader(const struct gguf_reader & gr
         {
             uint32_t n_dims = 0;
             ok = ok && gr.read(n_dims);
-            if (n_dims > GGML_MAX_DIMS) {
-                GGML_LOG_ERROR("%s: tensor '%s' has invalid number of dimensions: %" PRIu32 " > %" PRIu32 "\n",
-                    __func__, info.t.name, n_dims, GGML_MAX_DIMS);
-                ok = false;
-                break;
-            }
-            for (uint32_t j = 0; ok && j < GGML_MAX_DIMS; ++j) {
-                info.t.ne[j] = 1;
-                if (j < n_dims) {
-                    ok = ok && gr.read(info.t.ne[j]);
-                }
-
-                // check that all ne are non-negative
-                if (info.t.ne[j] < 0) {
-                    GGML_LOG_ERROR("%s: tensor '%s' dimension %" PRIu32 " has invalid number of elements: %" PRIi64 " < 0\n",
-                        __func__, info.t.name, j, info.t.ne[j]);
+            // MCA patch: Wan 2.2 DiT stores patch_embedding.weight as a 5D tensor. Aborting the scan
+            // silently dropped every following tensor, so instead read all dims and fold anything above
+            // 4D into ne[3] (ggml's [kw,kh,kd,in*out] convolution layout).
+            {
+                const uint32_t n_dims_raw = n_dims;
+                uint64_t raw[8] = {1,1,1,1,1,1,1,1};
+                if (n_dims_raw > 8) {
+                    GGML_LOG_ERROR("%s: tensor '%s' has unsupported number of dimensions: %u\n", __func__, info.t.name, n_dims_raw);
                     ok = false;
                     break;
                 }
+                for (uint32_t j = 0; ok && j < n_dims_raw; ++j) {
+                    ok = ok && gr.read(raw[j]);
+                }
+                if (!ok) { break; }
+                for (int j = 0; j < GGML_MAX_DIMS; ++j) { info.t.ne[j] = 1; }
+                for (uint32_t j = 0; j < n_dims_raw; ++j) {
+                    if (j < (uint32_t)(GGML_MAX_DIMS - 1)) { info.t.ne[j] = (int64_t) raw[j]; }
+                    else { info.t.ne[GGML_MAX_DIMS - 1] *= (int64_t) raw[j]; }
+                }
+                if (n_dims_raw > GGML_MAX_DIMS) {
+                    GGML_LOG_WARN("%s: tensor '%s' stacked %uD shape into 4D (%" PRIi64 ", %" PRIi64 ", %" PRIi64 ", %" PRIi64 ")\n",
+                        __func__, info.t.name, n_dims_raw, info.t.ne[0], info.t.ne[1], info.t.ne[2], info.t.ne[3]);
+                }
+                for (int j = 0; j < GGML_MAX_DIMS; ++j) {
+                    if (info.t.ne[j] < 0) {
+                        GGML_LOG_ERROR("%s: tensor '%s' dimension %d has invalid number of elements: %" PRIi64 " < 0\n",
+                            __func__, info.t.name, j, info.t.ne[j]);
+                        ok = false;
+                        break;
+                    }
+                }
             }
 
             // check that the total number of elements is representable
