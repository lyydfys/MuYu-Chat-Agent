+// Consumer for incrementally produced temporal tiles.
+//
+// `output_tile` contains only the frames of this tile and is released as soon as the callback
+// returns, so a consumer must copy or write whatever it needs during the call.
+//
+// The return value is a status, not a plain bool, because "the consumer already has enough frames"
+// is a *successful* early stop and must not be reported as a failed generation:
+//   - CONTINUE: keep decoding the remaining tiles.
+//   - STOP:     the consumer is satisfied (for example it reached its requested frame count).
+//               Decoding ends here and the run is SUCCESSFUL.
+//   - ABORT:    the consumer failed (write error, cancellation, rejected frame). The caller must
+//               treat the generation as failed and publish nothing.
+//
+// Passing an empty VAETileSink to the decode paths keeps the original whole-video behaviour.
+enum class VAETileSinkStatus {
+    CONTINUE = 0,
+    STOP     = 1,
+    ABORT    = 2,
+};
+
+using VAETileSink = std::function<VAETileSinkStatus(const VAETemporalTile& tile, const sd::Tensor<float>& output_tile)>;
+
