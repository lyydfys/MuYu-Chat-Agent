+// Incremental temporal tiling.
+//
+// Same tile plan and same per-tile processing as process_vae_temporal_tiles(), but each finished
+// tile is handed to `on_tile_output(tile, output_tile)` instead of being concatenated into one
+// whole-video tensor. The consumer must keep whatever it needs before the next tile starts;
+// `output_tile` is released when the callback returns.
+//
+// The existing process_vae_temporal_tiles() path is untouched, so default behaviour is unchanged.
+// Returns false only when a tile produced no output or the consumer reported ABORT; a consumer
+// that reports STOP (satisfied early) is a successful run.
+template <typename Fn, typename Sink>
+inline bool process_vae_temporal_tiles_streaming(const sd::Tensor<float>& input,
+                                                 const VAETemporalTilePlan& plan,
+                                                 Fn&& on_processing,
+                                                 Sink&& on_tile_output) {
+    for (const auto& tile : plan.tiles) {
+        auto input_tile  = sd::ops::slice(input, 2, tile.start, tile.end);
+        auto output_tile = on_processing(input_tile, tile);
+        if (output_tile.empty()) {
+            return false;
+        }
+        LOG_VERBOSE("vae temporal tile %d/%d: latent [%lld, %lld) -> %lld output frames",
+                    tile.index + 1,
+                    (int)plan.tiles.size(),
+                    (long long)tile.start,
+                    (long long)tile.end,
+                    (long long)output_tile.shape()[2]);
+        const VAETileSinkStatus status = on_tile_output(tile, output_tile);
+        if (status == VAETileSinkStatus::ABORT) {
+            return false;
+        }
+        if (status == VAETileSinkStatus::STOP) {
+            // Consumer is satisfied (e.g. it reached the requested frame count): stop decoding more
+            // tiles, but this is a successful run, not a failure.
+            LOG_VERBOSE("vae temporal tile stream stopped by the consumer after %d/%d tile(s)",
+                        tile.index + 1,
+                        (int)plan.tiles.size());
+            return true;
+        }
+    }
+    return true;
+}
