+    // nightmare (dit/073): on Hexagon a matmul's result passes through fp16, and H3's latents came back NaN with the DiT
+    // on the NPU (the S25; the same file, step and prompt on the CPU drew the cat). Linear::set_scale runs x * s through
+    // the matmul and the result / s (dit/025, dit/045). Bisected on FastH3 at 256x256: condition_proj (the text
+    // embedding's projection) at 1/32 alone cleans a 21-frame clip (qkv or out alone stayed NaN); at 124 frames the
+    // attention out_proj overflows too (condition + qkv stayed NaN), so both get 1/32 by default.
+    // NM_H3_HTP_SCALE="name:scale,..." replaces the default, per projection name (qkv, out, fc1, fc2, condition,
+    // video_in, audio_in, video_out, audio_out; "all" matches every one); a name not listed keeps its own scale
+    // (upstream gives fc1/fc2 1/128). HTP only: every other backend is unchanged.
+    static void h3_htp_scale(GGMLRunnerContext* ctx, const std::shared_ptr<Linear>& l, const char* name) {
+        if (!l || ctx->backend == nullptr || !sd_backend_is(ctx->backend, "HTP")) {
+            return;
+        }
+        static const std::vector<std::pair<std::string, float>> table = [] {
+            std::vector<std::pair<std::string, float>> t;
+            const char* e    = std::getenv("NM_H3_HTP_SCALE");
+            std::string spec = e ? e : "condition:0.03125,out:0.03125";
+            size_t pos       = 0;
+            while (pos < spec.size()) {
+                size_t end = spec.find(',', pos);
+                if (end == std::string::npos) end = spec.size();
+                std::string item = spec.substr(pos, end - pos);
+                size_t colon     = item.find(':');
+                if (colon != std::string::npos) {
+                    t.emplace_back(item.substr(0, colon), (float)std::atof(item.c_str() + colon + 1));
+                }
+                pos = end + 1;
+            }
+            return t;
+        }();
+        for (const auto& [n, v] : table) {
+            if (n == "all" || n == name) {
+                l->set_scale(v);
+                return;
+            }
+        }
+    }
