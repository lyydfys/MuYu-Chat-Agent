+// nightmare (dit/069): the row kernels (binary-ops.c `spad_row_total`, act-ops.c `htp_act_vtcm_layout_build`) need at
+// least ONE row of every operand per thread in VTCM, double-buffered; a row too wide aborts the graph with VTCM-TOO-SMALL.
+// MiniMax-H3's AdaLN curve rows are 96768 floats and its audio decoder's are a clip's samples (160k at 32 kHz x 5 s):
+// such an op stays on the CPU, and every narrower one (a DiT's residuals, 5376 wide) stays on the NPU.
+static bool nm_rows_fit_vtcm(const struct ggml_hexagon_session * sess, const struct ggml_tensor * a,
+                             const struct ggml_tensor * b, const struct ggml_tensor * d) {
+    if (!sess || sess->vtcm_size == 0) {
+        return true;
+    }
+    auto row = [](const struct ggml_tensor * t) -> size_t {
+        return t ? (((size_t) t->ne[0] * ggml_type_size(t->type)) + 127) & ~(size_t) 127 : 0;
+    };
+    const size_t nt = sess->n_threads > 0 ? sess->n_threads : 1;
+    return 2 * (row(a) + row(b) + row(d)) * nt + row(b) <= sess->vtcm_size;
+}
