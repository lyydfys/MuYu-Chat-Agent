+    // nightmare (dit/071): q/k RMSNorm on the backend's fused qknorm+rope op (the HTP's ggml_qknorm_rope). H3's rope is
+    // rotate-half over the first rot_dim (96) of 128 dims, pairs (j, j + rot_dim/2); the kernel is interleaved over all
+    // 128, pairs (2j, 2j+1). So the first rot_dim channels (and the norm weight) are reordered j -> 2j, j + rot_dim/2 ->
+    // 2j+1, the tail stays, and the table is padded to 64 pairs with identity rotations (zero angles, build_rope). q and
+    // k get the same reordering, which leaves q.k (all attention reads) unchanged. The composed rope was 82 s of a 110 s
+    // step on the S25 (REPEAT 54 s, MUL 20 s, ADD 10 s on [2, 48, L, 56] tensors); the matmuls were 7.7 s.
+    class H3QKNorm : public RMSNorm {
+    public:
+        using RMSNorm::RMSNorm;
+
+        ggml_tensor* try_forward_rope_partial(GGMLRunnerContext* ctx, ggml_tensor* x, ggml_tensor* theta, int64_t rot_dim) {
+            const int64_t d = x->ne[0];
+            if (ctx->backend == nullptr || rot_dim <= 0 || rot_dim > d || rot_dim % 2 != 0 || theta->ne[2] * 2 != d) {
+                return nullptr;
+            }
+            ggml_context* c = ctx->ggml_ctx;
+            ggml_tensor* w  = params["weight"];
+            if (ctx->weight_adapter) {
+                w = ctx->weight_adapter->patch_weight(c, ctx->backend, w, prefix + "weight");
+            }
+            auto reorder = [&](ggml_tensor* t, int64_t rows) {
+                auto t2  = ggml_reshape_2d(c, t, d, rows);
+                auto rot = ggml_cont(c, ggml_view_2d(c, t2, rot_dim, rows, t2->nb[1], 0));
+                rot      = ggml_reshape_3d(c, rot, rot_dim / 2, 2, rows);
+                rot      = ggml_reshape_2d(c, ggml_cont(c, ggml_permute(c, rot, 1, 0, 2, 3)), rot_dim, rows);
+                if (rot_dim == d) {
+                    return rot;
+                }
+                auto tail = ggml_cont(c, ggml_view_2d(c, t2, d - rot_dim, rows, t2->nb[1], rot_dim * ggml_element_size(t2)));
+                return ggml_concat(c, rot, tail, 0);
+            };
+            auto xi          = ggml_reshape_4d(c, reorder(x, x->ne[1] * x->ne[2] * x->ne[3]), d, x->ne[1], x->ne[2], x->ne[3]);
+            auto wi          = ggml_reshape_1d(c, reorder(w, 1), d);
+            ggml_tensor* out = ggml_qknorm_rope(c, xi, wi, theta, eps);
+            return ggml_backend_supports_op(ctx->backend, out) ? out : nullptr;
+        }
+    };
