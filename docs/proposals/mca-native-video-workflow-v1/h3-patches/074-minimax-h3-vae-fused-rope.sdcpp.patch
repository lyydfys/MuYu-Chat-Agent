+    // nightmare (dit/074): the decoder's weightless q/k RMSNorm and partial rope on the backend's fused qknorm+rope op
+    // (the HTP's ggml_qknorm_rope), as dit/071 does for the DiT: the rope is rotate-half over the first rot_dim (48) of 64
+    // dims, the kernel interleaved over all 64, so the first rot_dim channels are reordered j -> 2j, j + rot_dim/2 ->
+    // 2j+1 (q and k alike, q.k unchanged) and build_rope pads the table to 32 pairs with identity rotations. The weight
+    // is ones. The composed rope was ~315 ms of every layer on the S25 (REPEAT, MUL, ADD on [2, 24, L, 32] tensors), 36
+    // layers per chunk. Returns nullptr when the backend cannot take it.
+    static ggml_tensor* fused_qknorm_rope(GGMLRunnerContext* ctx,
+                                          ggml_tensor* x,
+                                          ggml_tensor* theta,
+                                          int64_t rot_dim,
+                                          float eps) {
+        const int64_t d = x->ne[0];
+        if (ctx->backend == nullptr || rot_dim <= 0 || rot_dim > d || rot_dim % 2 != 0 || theta->ne[2] * 2 != d) {
+            return nullptr;
+        }
+        ggml_context* c = ctx->ggml_ctx;
+        int64_t rows    = x->ne[1] * x->ne[2] * x->ne[3];
+        auto t2         = ggml_reshape_2d(c, ggml_is_contiguous(x) ? x : ggml_cont(c, x), d, rows);
+        auto rot        = ggml_cont(c, ggml_view_2d(c, t2, rot_dim, rows, t2->nb[1], 0));
+        rot             = ggml_reshape_3d(c, rot, rot_dim / 2, 2, rows);
+        rot             = ggml_reshape_2d(c, ggml_cont(c, ggml_permute(c, rot, 1, 0, 2, 3)), rot_dim, rows);
+        if (rot_dim < d) {
+            auto tail = ggml_cont(c, ggml_view_2d(c, t2, d - rot_dim, rows, t2->nb[1], rot_dim * ggml_element_size(t2)));
+            rot       = ggml_concat(c, rot, tail, 0);
+        }
+        auto xi          = ggml_reshape_4d(c, rot, d, x->ne[1], x->ne[2], x->ne[3]);
+        ggml_tensor* out = ggml_qknorm_rope(c, xi, ggml_ext_ones(c, d, 1, 1, 1), theta, eps);
+        return ggml_backend_supports_op(ctx->backend, out) ? out : nullptr;
+    }
