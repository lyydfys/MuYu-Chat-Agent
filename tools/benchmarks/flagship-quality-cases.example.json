{
  "schemaVersion": 1,
  "artifactType": "benchmark_config",
  "suite": {
    "id": "mca-local-ai-flagship-acceptance-v1",
    "version": "1.0",
    "status": "definition_only",
    "containsMeasuredResults": false,
    "description": "MCA QNN chat, QNN/VLM vision, QNN image and MNN image product-quality acceptance matrix.",
    "companionDocument": "docs/experiments/LOCAL_AI_FLAGSHIP_ACCEPTANCE.md",
    "requiredTracks": ["qnn_chat", "qnn_vlm", "qnn_image", "mnn_image"],
    "allowedResultStates": ["not_run", "not_measured", "not_applicable", "invalid", "fail", "pass"],
    "placeholderRule": "Any unresolved __SET_*__ value makes an execution invalid."
  },
  "defaults": {
    "runs": 3,
    "warmupRuns": 1,
    "timeoutSeconds": 1200,
    "pollIntervalMs": 1000,
    "cooldownSeconds": 45,
    "forceStopBeforeRun": true,
    "stabilityCvThresholdPercent": 15.0,
    "cancellationProbe": false,
    "cancellationDelayMs": 750,
    "cancellationMaxTokens": 512,
    "cancellationTimeoutSeconds": 30,
    "temperature": 0.0,
    "reasoningMode": "off",
    "humanReviewers": 2,
    "telemetrySampleIntervalMs": 1000
  },
  "executionProtocol": {
    "measuredRunsMustBeIndependent": true,
    "sameInputsAcrossMeasuredRuns": true,
    "sameSeedAcrossImageMeasuredRuns": true,
    "recordWarmupButExcludeFromAggregates": true,
    "restartAppAndReloadModelBeforeEachMeasuredRun": true,
    "startTelemetryBeforeModelLoad": true,
    "stopTelemetryAtLeastMsAfterTerminalEvent": 2000,
    "cooldownUntilWithinStartTemperatureC": 2.0,
    "maximumCooldownSeconds": 300,
    "qualityAdapterRequired": true,
    "legacyRunnerCompatibility": "run-real-device-comparison.ps1 validates schemaVersion, kind and scalar extras, but smoke activities do not guarantee injection of qualityInput."
  },
  "metricContract": {
    "commonRequired": [
      "loadMs",
      "totalDurationMs",
      "rssStartMb",
      "peakRssMb",
      "rssEndMb",
      "availableRamMinMb",
      "batteryTemperatureStartC",
      "batteryTemperatureMaxC",
      "batteryTemperatureEndC",
      "thermalStatusStart",
      "thermalStatusMax",
      "thermalStatusEnd",
      "batteryLevelStartPercent",
      "batteryLevelEndPercent",
      "chargingState",
      "cancelLatencyMs",
      "threeRunStability"
    ],
    "chatAndVisionRequired": ["promptTokens", "completionTokens", "ttftMs", "decodeTps"],
    "imageRequired": ["firstProgressMs", "stepsCompleted", "stepsPerSecond", "outputWidth", "outputHeight", "outputSha256"],
    "imageNotApplicable": ["ttftMs", "decodeTps"],
    "memorySourcePriority": ["proc_status_vmrss", "dumpsys_total_rss"],
    "batteryOptionalCounters": ["chargeCounterStartUah", "chargeCounterEndUah", "energyCounterStartNwh", "energyCounterEndNwh"],
    "missingValueRule": "Use null plus not_measured/not_applicable; never substitute zero.",
    "stabilityStatistics": ["values", "median", "mean", "sampleStandardDeviation", "coefficientOfVariationPercent", "minimum", "maximum"]
  },
  "acceptanceThresholds": {
    "global": {
      "measuredRunSuccessesRequired": 3,
      "measuredRunsRequired": 3,
      "crashAnrOomMax": 0,
      "fallbackCountMax": 0,
      "emptyOrCorruptOutputMax": 0,
      "peakRssFractionOfPhysicalRamMax": 0.75,
      "availableRamMinMb": 768,
      "batteryTemperatureMaxC": 45.0,
      "batteryTemperatureDeltaCMax": 8.0,
      "thermalStatusForbiddenAtOrAbove": "SEVERE",
      "batteryLevelDropPerRunPercentMax": 2.0,
      "humanWeightedScoreMedianMin": 4.0,
      "humanWeightedScorePerOutputMin": 3.5,
      "humanDimensionMin": 3.0,
      "criticalDefectsMax": 0,
      "humanReviewersRequired": 2
    },
    "qnn_chat": {
      "backendEvidencePerRunRequired": true,
      "actualRequestMustUseQnnOrQairt": true,
      "ttftMedianMsMax": 1500,
      "decodeTpsMedianMin": 12.0,
      "ttftCvPercentMax": 20.0,
      "decodeTpsCvPercentMax": 10.0,
      "totalDurationCvPercentMax": 15.0,
      "cancelLatencyMsMax": 1000,
      "cancellationRunsRequired": 3
    },
    "qnn_vlm": {
      "backendEvidencePerRunRequired": true,
      "actualRequestMustUseQnnOrQairt": true,
      "ttftMedianMsMax": 6000,
      "decodeTpsMedianMin": 6.0,
      "ttftCvPercentMax": 20.0,
      "decodeTpsCvPercentMax": 15.0,
      "totalDurationCvPercentMax": 15.0,
      "cancelLatencyMsMax": 1500,
      "cancellationRunsRequired": 3
    },
    "qnn_image": {
      "backendEvidencePerRunRequired": true,
      "runtimeRequired": "qnn_htp",
      "actualGraphExecuteRequired": true,
      "npuActiveRequired": true,
      "totalDurationMedianMsMax": 30000,
      "firstProgressMedianMsMax": 3000,
      "totalDurationCvPercentMax": 12.0,
      "peakRssCvPercentMax": 10.0,
      "cancelLatencyMsMax": 2000,
      "cancellationRunsRequired": 3
    },
    "mnn_image": {
      "backendEvidencePerRunRequired": true,
      "runtimeRequired": "mnn_diffusion",
      "totalDurationMedianMsMax": 120000,
      "firstProgressMedianMsMax": 8000,
      "totalDurationCvPercentMax": 15.0,
      "peakRssCvPercentMax": 10.0,
      "cancelLatencyMsMax": 3000,
      "cancellationRunsRequired": 3
    },
    "energyRegression": {
      "firstApprovedSessionState": "baseline_created",
      "sameDeviceNormalizedDrainRegressionPercentMax": 15.0,
      "normalization": "charge counter drain per minute",
      "chargingStateMustRemainConstant": true
    }
  },
  "rubrics": {
    "text_or_vision_v1": {
      "scale": {
        "0": "Empty, corrupt, completely wrong or unsafe.",
        "1": "Only a small relevant fragment is usable.",
        "2": "Major requirements are missing or wrong.",
        "3": "Usable with obvious errors.",
        "4": "Minor issues do not block use.",
        "5": "Complete, correct and directly usable."
      },
      "dimensions": [
        {"id": "correctness", "weight": 0.4},
        {"id": "instructionFollowing", "weight": 0.25},
        {"id": "completenessRelevance", "weight": 0.2},
        {"id": "chineseReadabilityConciseness", "weight": 0.15}
      ]
    },
    "image_generation_v1": {
      "scale": {
        "0": "Empty, corrupt or unrelated image.",
        "1": "Barely recognizable target.",
        "2": "Major prompt or structural failure.",
        "3": "Usable with visible defects.",
        "4": "Minor defects only.",
        "5": "Strong prompt fidelity and production-ready visual quality."
      },
      "dimensions": [
        {"id": "promptFidelity", "weight": 0.3},
        {"id": "compositionSpatialRelations", "weight": 0.2},
        {"id": "subjectStructure", "weight": 0.2},
        {"id": "artifactFreedom", "weight": 0.2},
        {"id": "visualCoherence", "weight": 0.1}
      ]
    }
  },
