+        params->vae_tiling_params.rel_size_y <= 0.0f) {
+        return fail("UltraFix requires explicit VAE encode/decode tiling parameters");
+    }
+    const int vae_scale = sd_ctx->sd->get_vae_scale_factor();
+    const int unet_alignment = sd_version_is_sdxl(sd_ctx->sd->version) ? 4 : 8;
+    if (params->width % (vae_scale * unet_alignment) != 0 ||
+        params->height % (vae_scale * unet_alignment) != 0 ||
+        params->tile_size % (vae_scale * unet_alignment) != 0) {
+        return fail("the target and tile dimensions do not align to the loaded UNet topology");
+    }
+    if (sd_should_cancel()) {
+        evidence->cancelled = 1u;
+        return nullptr;
+    }
+
+    ImageExecutionEvidenceScope image_execution_scope(
+        sd_ctx->sd->image_execution_evidence);
+    VaeImageExecutionEvidenceScope vae_execution_scope(
+        sd_ctx->sd->first_stage_model,
+        sd_ctx->sd->preview_vae,
+        &sd_ctx->sd->image_execution_evidence.summary);
+
+    sd_img_gen_params_t generation;
+    sd_img_gen_params_init(&generation);
+    generation.loras                         = params->loras;
+    generation.lora_count                    = params->lora_count;
+    generation.prompt                        = params->prompt;
+    generation.negative_prompt               = params->negative_prompt;
+    generation.clip_skip                     = params->clip_skip;
+    generation.init_image                    = params->init_image;
+    generation.width                         = params->width;
+    generation.height                        = params->height;
+    generation.strength                      = 1.0f;
+    generation.seed                          = params->seed;
+    generation.batch_count                   = 1;
+    generation.vae_tiling_params             = params->vae_tiling_params;
+    generation.sample_params.sample_steps    = params->refinement_steps;
+    generation.sample_params.sample_method   = params->sample_method;
+    generation.sample_params.scheduler       = params->scheduler;
+    generation.sample_params.eta             = params->eta;
+    generation.sample_params.extra_sample_args = params->extra_sample_args;
+    generation.sample_params.guidance.txt_cfg = params->cfg_scale;
+
+    sd_ctx->sd->vae_tiling_params = params->vae_tiling_params;
+    GenerationRequest request(sd_ctx, &generation);
+    if (request.width != params->width || request.height != params->height) {
+        return fail("stable-diffusion.cpp would alter the exact UltraFix target canvas");
+    }
+    sd_ctx->sd->rng->manual_seed(request.seed);
+    sd_ctx->sd->sampler_rng->manual_seed(request.seed);
+    sd_ctx->sd->apply_loras(params->loras, params->lora_count);
+    ImageVaeAxesGuard axes_guard(sd_ctx, &generation, request);
+    SamplePlan plan(sd_ctx, &generation, request);
+    if (plan.sample_method != params->sample_method ||
+        plan.sample_steps != params->refinement_steps ||
+        plan.sigmas.size() != static_cast<size_t>(params->refinement_steps + 1)) {
+        return fail("the resolved sampler schedule differs from the immutable UltraFix request");
+    }
+
+    // Match Local Dream's image decoder: preserve aspect ratio, scale until
+    // the target is covered, then center-crop. Keep this inside the native
+    // request so Local API and MainActivity execute identical pixels.
+    const uint64_t source_width = params->init_image.width;
+    const uint64_t source_height = params->init_image.height;
+    const uint64_t target_width = static_cast<uint64_t>(params->width);
+    const uint64_t target_height = static_cast<uint64_t>(params->height);
+    uint64_t resized_width = target_width;
+    uint64_t resized_height = target_height;
+    if (target_width * source_height >= target_height * source_width) {
+        resized_height = source_height * target_width / source_width;
+    } else {
+        resized_width = source_width * target_height / source_height;
+    }
+    if (resized_width < target_width || resized_height < target_height ||
+        resized_width > 8192u || resized_height > 8192u ||
+        resized_width * resized_height > 64u * 1024u * 1024u) {
+        return fail("the aspect-preserving UltraFix source fit exceeds its bounded canvas");
+    }
+    evidence->source_resized_width = static_cast<uint32_t>(resized_width);
+    evidence->source_resized_height = static_cast<uint32_t>(resized_height);
+    evidence->source_crop_left =
+        static_cast<uint32_t>((resized_width - target_width) / 2u);
+    evidence->source_crop_top =
+        static_cast<uint32_t>((resized_height - target_height) / 2u);
+
+    if (sd_should_cancel()) {
+        evidence->cancelled = 1u;
+        return nullptr;
+    }
+    sd::Tensor<float> source_tensor = sd_image_to_tensor(params->init_image);
+    if (source_tensor.empty() || sd_should_cancel()) {
+        evidence->cancelled = sd_should_cancel() ? 1u : 0u;
+        return nullptr;
+    }
+    if (resized_width != source_width || resized_height != source_height) {
+        source_tensor = sd::ops::interpolate(
+            source_tensor,
+            {static_cast<int64_t>(resized_width),
+             static_cast<int64_t>(resized_height),
+             3,
+             1},
+            sd::ops::InterpolateMode::Bilinear);
+    }
+    if (source_tensor.empty() || sd_should_cancel()) {
+        evidence->cancelled = sd_should_cancel() ? 1u : 0u;
+        return nullptr;
+    }
+    sd::Tensor<float> fitted_source;
+    if (resized_width == target_width && resized_height == target_height) {
+        fitted_source = std::move(source_tensor);
+    } else {
+        fitted_source = sd::Tensor<float>(
+            {static_cast<int64_t>(target_width),
+             static_cast<int64_t>(target_height),
+             3,
+             1});
+        for (uint64_t y = 0u; y < target_height; ++y) {
+            if ((y & 31u) == 0u && sd_should_cancel()) {
+                evidence->cancelled = 1u;
+                return nullptr;
+            }
+            for (uint64_t x = 0u; x < target_width; ++x) {
+                for (int64_t channel = 0; channel < 3; ++channel) {
+                    fitted_source.index(
+                        static_cast<int64_t>(x),
+                        static_cast<int64_t>(y),
+                        channel,
+                        0) = source_tensor.index(
+                            static_cast<int64_t>(x + evidence->source_crop_left),
+                            static_cast<int64_t>(y + evidence->source_crop_top),
+                            channel,
+                            0);
+                }
+            }
+        }
+    }
+    source_tensor = sd::Tensor<float>();
+
+    evidence->vae_encode_invocation_count = 1u;
+    ImageGenerationLatents latents;
+    latents.init_latent = sd_ctx->sd->encode_first_stage(fitted_source);
+    if (sd_should_cancel()) {
+        evidence->cancelled = 1u;
+        return nullptr;
+    }
+    if (latents.init_latent.empty()) {
+        return fail("VAE encoding did not produce an input latent");
+    }
+    evidence->vae_encode_success_count = 1u;
+    evidence->vae_encode_tile_count =
+        sd_ctx->sd->image_execution_evidence.summary.vae_encode_tile_compute_attempt_count;
+    evidence->vae_encode_tile_success_count =
+        sd_ctx->sd->image_execution_evidence.summary.vae_encode_tile_compute_success_count;
+    auto embeds_opt = prepare_image_generation_embeds(
+        sd_ctx, &generation, &request, &plan, &latents);
+    if (sd_should_cancel()) {
+        evidence->cancelled = 1u;
+        return nullptr;
+    }
+    if (!embeds_opt.has_value()) {
+        return fail("prompt conditioning failed before UltraFix inversion");
+    }
+    ImageGenerationEmbeds embeds = std::move(*embeds_opt);
+
+    const int denoise_start = params->refinement_steps - params->inversion_steps;
+    sd::Tensor<float> inverted = latents.init_latent;
+    float source_sigma = 0.0f;
+    const int64_t inversion_started_us = ggml_time_us();
+    for (int index = params->refinement_steps - 1;
+         index >= denoise_start;
+         --index) {
+        if (sd_should_cancel()) {
+            evidence->cancelled = 1u;
+            return nullptr;
+        }
+        const float target_sigma = plan.sigmas[static_cast<size_t>(index)];
+        const float evaluation_sigma = source_sigma > 0.0f
+            ? source_sigma
+            : target_sigma;
+        if (!std::isfinite(target_sigma) || target_sigma <= source_sigma ||
+            !std::isfinite(evaluation_sigma) || evaluation_sigma <= 0.0f) {
+            return fail("the inversion ladder is not strictly increasing in noise level");
+        }
+        ++evidence->ddim_inversion_invocation_count;
+        StableDiffusionGGML::UltraFixPrediction prediction =
+            sd_ctx->sd->ultrafix_tiled_prediction(
+                inverted,
+                evaluation_sigma,
+                embeds.cond,
+                SDCondition(),
+                1.0f,
+                params->tile_size,
+                params->tile_overlap,
+                params->width,
+                params->height,
+                true);
+        if (prediction.denoised.empty() || prediction.tile_count == 0u ||
+            prediction.denoised.shape() != inverted.shape()) {
+            return fail("a tiled DDIM inversion evaluation failed");
+        }
+        sd::Tensor<float> epsilon =
+            (inverted - prediction.denoised) / evaluation_sigma;
+        sd::Tensor<float> x0_prediction = inverted - epsilon * source_sigma;
+        inverted = x0_prediction + epsilon * target_sigma;
+        source_sigma = target_sigma;
+        ++evidence->ddim_inversion_success_count;
+        ++evidence->ddim_inversion_step_count;
+        evidence->ddim_inversion_tile_count += prediction.tile_count;
+        evidence->ddim_inversion_tile_success_count += prediction.tile_count;
+        const int inversion_completed_step = params->refinement_steps - index;
+        sd_ctx->sd->report_auxiliary_progress(
+            inversion_completed_step,
+            static_cast<size_t>(params->inversion_steps) * 2u,
+            inversion_started_us);
+    }
+    if (evidence->ddim_inversion_step_count !=
+        static_cast<uint64_t>(params->inversion_steps) ||
+        std::fabs(source_sigma - plan.sigmas[static_cast<size_t>(denoise_start)]) >
+            std::max(1.0e-6f, std::fabs(source_sigma) * 1.0e-5f)) {
+        return fail("the DDIM inversion ladder did not reach the requested start sigma");
+    }
+
+    if (latents.init_latent.dim() != 4 ||
+        latents.init_latent.shape()[0] <= 0 ||
+        latents.init_latent.shape()[1] <= 0 ||
+        latents.init_latent.shape()[2] <= 0 ||
+        latents.init_latent.shape()[3] <= 0) {
+        return fail("the UltraFix latent does not expose a canonical four-dimensional shape");
+    }
+    const mca::image::SpatialTensorShape ultra_fix_latent_shape{
+        static_cast<size_t>(latents.init_latent.shape()[3]),
+        static_cast<size_t>(latents.init_latent.shape()[2]),
+        static_cast<size_t>(latents.init_latent.shape()[1]),
+        static_cast<size_t>(latents.init_latent.shape()[0]),
+        mca::image::SpatialTensorLayout::Nchw,
+    };
+    std::vector<float> ultra_fix_equivalent_noise;
+    std::string ultra_fix_quality_error;
+    if (params->inversion_steps > 1) {
+        const mca::image::UltraFixNoiseLevel inverted_level{
+            1.0,
+            static_cast<double>(source_sigma),
+            1.0 / std::sqrt(1.0 +
+                static_cast<double>(source_sigma) * source_sigma),
+        };
+        if (!mca::image::ultrafix_equivalent_noise(
+                latents.init_latent.values(),
+                inverted.values(),
+                inverted_level,
+                &ultra_fix_equivalent_noise,
+                &ultra_fix_quality_error)) {
+            return fail(ultra_fix_quality_error.c_str());
+        }
+        evidence->trajectory_noise_checksum =
+            mca::image::ultrafix_tensor_checksum(ultra_fix_equivalent_noise);
+        if (evidence->trajectory_noise_checksum == 0u) {
+            return fail("the UltraFix inverted trajectory lacks checksum evidence");
+        }
+    }
+
+    std::vector<float> denoise_sigmas(
+        plan.sigmas.begin() + denoise_start,
+        plan.sigmas.end());
+    if (denoise_sigmas.size() !=
+        static_cast<size_t>(params->inversion_steps + 1)) {
+        return fail("the strength-derived denoising schedule has the wrong length");
+    }
+    sd_ctx->sd->image_execution_evidence.record_sampling_pass();
+    const int64_t sample_started_us = ggml_time_us();
+    std::vector<mca::image::UltraFixQualitySchedule> quality_schedules(
+        static_cast<size_t>(params->inversion_steps));
+    auto tiled_denoise = [&](const sd::Tensor<float>& x,
+                             float sigma,
+                             int step) -> sd::guidance::GuiderOutput {
+        sd::guidance::GuiderOutput output;
+        if (sd_should_cancel()) {
+            evidence->cancelled = 1u;
+            return output;
+        }
+        ++evidence->tiled_unet_invocation_count;
+        StableDiffusionGGML::UltraFixPrediction prediction =
+            sd_ctx->sd->ultrafix_tiled_prediction(
+                x,
+                sigma,
+                embeds.cond,
+                embeds.uncond,
+                params->cfg_scale,
+                params->tile_size,
+                params->tile_overlap,
+                params->width,
+                params->height,
+                false);
+        if (prediction.denoised.empty() || prediction.tile_count == 0u ||
+            !std::isfinite(prediction.model_timestep) ||
+            prediction.denoised.shape() != x.shape()) {
+            return output;
+        }
+        const int physical_step = std::abs(step) - 1;
+        if (physical_step < 0 || physical_step >= params->inversion_steps) {
+            ultra_fix_quality_error =
+                "the UltraFix sampler reported an out-of-range refinement step";
+            return output;
+        }
+        const bool has_next_step = physical_step + 1 < params->inversion_steps;
+        mca::image::UltraFixQualitySchedule quality_schedule;
+        if (!mca::image::resolve_ultrafix_quality_schedule(
+                static_cast<double>(prediction.model_timestep),
+                has_next_step,
+                &quality_schedule,
+                &ultra_fix_quality_error)) {
+            return output;
+        }
+        quality_schedules[static_cast<size_t>(physical_step)] = quality_schedule;
+        if (has_next_step) {
+            ++evidence->quality_step_evaluation_count;
+        }
+        if (quality_schedule.evaluate_noise_injection) {
+            if (sd_should_cancel() || !(sigma > 0.0f)) {
+                evidence->cancelled = sd_should_cancel() ? 1u : 0u;
+                ultra_fix_quality_error =
+                    "UltraFix quality-noise injection was cancelled or received zero sigma";
+                return output;
+            }
+            std::vector<float> epsilon(prediction.denoised.values().size(), 0.0f);
+            for (size_t index = 0u; index < epsilon.size(); ++index) {
+                epsilon[index] =
+                    (x.values()[index] - prediction.denoised.values()[index]) / sigma;
+            }
+            std::vector<float> mixed_epsilon;
+            uint64_t gaussian_checksum = 0u;
+            uint64_t mixed_checksum = 0u;
+            if (!mca::image::ultrafix_inject_spherical_noise(
+                    epsilon,
+                    static_cast<uint64_t>(params->seed),
+                    static_cast<uint32_t>(physical_step),
+                    quality_schedule.noise_injection_fraction,
+                    &mixed_epsilon,
+                    &gaussian_checksum,
+                    &mixed_checksum,
+                    &ultra_fix_quality_error)) {
+                return output;
+            }
+            for (size_t index = 0u; index < mixed_epsilon.size(); ++index) {
+                prediction.denoised.values()[index] =
+                    x.values()[index] - mixed_epsilon[index] * sigma;
+            }
+            evidence->noise_injection_checksum =
+                mca::image::ultrafix_accumulate_checksum(
+                    evidence->noise_injection_checksum,
+                    static_cast<uint32_t>(physical_step),
+                    gaussian_checksum);
+            evidence->noise_injection_checksum =
+                mca::image::ultrafix_accumulate_checksum(
+                    evidence->noise_injection_checksum,
+                    static_cast<uint32_t>(physical_step),
+                    mixed_checksum);
+            ++evidence->noise_injection_step_count;
+            if (sd_should_cancel()) {
+                evidence->cancelled = 1u;
+                return output;
+            }
+        }
+        ++evidence->tiled_unet_success_count;
+        ++evidence->tiled_unet_step_count;
+        evidence->tiled_unet_tile_count += prediction.tile_count;
+        evidence->tiled_unet_tile_success_count += prediction.tile_count;
+        sd_ctx->sd->report_sample_progress(
+            step < 0 ? -step : step,
+            static_cast<size_t>(params->inversion_steps),
+            sample_started_us,
+            static_cast<size_t>(params->inversion_steps),
+            static_cast<size_t>(params->inversion_steps) * 2u);
+        output.pred = std::move(prediction.denoised);
+        return output;
+    };
+    auto apply_ultra_fix_structure = [&](sd::Tensor<float>* sample,
+                                          int physical_step,
+                                          float next_sigma) -> bool {
+        if (sample == nullptr || sample->empty() || physical_step < 0 ||
+            physical_step >= params->inversion_steps) {
+            ultra_fix_quality_error =
+                "the UltraFix post-step callback received an invalid sample";
+            return false;
+        }
+        if (physical_step + 1 >= params->inversion_steps) {
+            return true;
+        }
+        const mca::image::UltraFixQualitySchedule& schedule =
+            quality_schedules[static_cast<size_t>(physical_step)];
+        if (!schedule.evaluate_structure_guidance) {
+            return true;
+        }
+        if (sd_should_cancel() || ultra_fix_equivalent_noise.empty() ||
+            !std::isfinite(next_sigma) || next_sigma < 0.0f) {
+            evidence->cancelled = sd_should_cancel() ? 1u : 0u;
+            ultra_fix_quality_error =
+                "UltraFix structure guidance was cancelled or lacks its trajectory";
+            return false;
+        }
+        const mca::image::UltraFixNoiseLevel next_level{
+            1.0,
+            static_cast<double>(next_sigma),
+            1.0 / std::sqrt(1.0 +
+                static_cast<double>(next_sigma) * next_sigma),
+        };
+        std::vector<float> trajectory_reference;
+        if (!mca::image::ultrafix_add_noise(
+                latents.init_latent.values(),
+                ultra_fix_equivalent_noise,
+                next_level,
+                &trajectory_reference,
+                &ultra_fix_quality_error)) {
+            return false;
+        }
+        if (sd_should_cancel()) {
+            evidence->cancelled = 1u;
+            return false;
+        }
+        std::vector<float> structured;
+        uint64_t structured_checksum = 0u;
+        const size_t blur_radius =
+            mca::image::ultrafix_structure_blur_radius(
+                static_cast<size_t>(params->tile_size / vae_scale));
+        if (blur_radius == 0u ||
+            !mca::image::ultrafix_apply_structure_guidance(
+                sample->values(),
+                trajectory_reference,
+                ultra_fix_latent_shape,
+                blur_radius,
+                schedule.structure_guidance_weight,
+                &structured,
+                &structured_checksum,
+                &ultra_fix_quality_error)) {
+            return false;
+        }
+        evidence->structure_guidance_checksum =
+            mca::image::ultrafix_accumulate_checksum(
+                evidence->structure_guidance_checksum,
+                static_cast<uint32_t>(physical_step),
+                structured_checksum);
+        ++evidence->structure_guidance_step_count;
+        sample->values() = std::move(structured);
+        if (sd_should_cancel()) {
+            evidence->cancelled = 1u;
+            return false;
+        }
+        return true;
+    };
+    sd::Tensor<float> final_latent = sample_k_diffusion(
+        params->sample_method,
+        tiled_denoise,
+        std::move(inverted),
+        denoise_sigmas,
+        sd_ctx->sd->sampler_rng,
+        params->eta,
+        false,
+        params->extra_sample_args,
+        apply_ultra_fix_structure);
+    if (sd_should_cancel()) {
+        evidence->cancelled = 1u;
+        return nullptr;
+    }
+    const uint64_t quality_step_count = evidence->quality_step_evaluation_count;
+    const bool quality_noise_evidence_consistent =
+        evidence->noise_injection_step_count <= quality_step_count &&
+        ((evidence->noise_injection_step_count == 0u) ==
+         (evidence->noise_injection_checksum == 0u));
+    const bool quality_structure_evidence_consistent =
+        evidence->structure_guidance_step_count <= quality_step_count &&
+        ((evidence->structure_guidance_step_count == 0u) ==
+         (evidence->structure_guidance_checksum == 0u));
+    const bool quality_coverage_complete = quality_step_count == 0u
+        ? evidence->trajectory_noise_checksum == 0u
+        : evidence->trajectory_noise_checksum != 0u &&
+              evidence->noise_injection_step_count +
+                      evidence->structure_guidance_step_count >=
+                  quality_step_count;
+    if (final_latent.empty() ||
+        evidence->tiled_unet_success_count !=
+            static_cast<uint64_t>(params->inversion_steps) ||
+        evidence->tiled_unet_step_count !=
+            static_cast<uint64_t>(params->inversion_steps) ||
+        evidence->quality_step_evaluation_count !=
+            static_cast<uint64_t>(std::max(params->inversion_steps - 1, 0)) ||
+        !quality_noise_evidence_consistent ||
+        !quality_structure_evidence_consistent ||
+        !quality_coverage_complete) {
+        return fail(ultra_fix_quality_error.empty()
+            ? "the full-image refinement scheduler or quality trajectory did not complete"
+            : ultra_fix_quality_error.c_str());
+    }
+    if (sd_ctx->sd->free_params_immediately) {
+        sd_ctx->sd->diffusion_model->free_params_buffer();
+    }
+
+    evidence->tiled_vae_decode_invocation_count = 1u;
+    sd::Tensor<float> decoded = sd_ctx->sd->decode_first_stage(final_latent);
+    if (sd_should_cancel()) {
+        evidence->cancelled = 1u;
+        return nullptr;
+    }
+    if (decoded.empty()) {
+        return fail("tiled VAE decode returned no image");
+    }
+    evidence->tiled_vae_decode_success_count = 1u;
+    evidence->tiled_vae_decode_tile_count =
+        sd_ctx->sd->image_execution_evidence.summary.vae_decode_tile_compute_attempt_count;
+    evidence->tiled_vae_decode_tile_success_count =
+        sd_ctx->sd->image_execution_evidence.summary.vae_decode_tile_compute_success_count;
+    if (sd_ctx->sd->free_params_immediately) {
+        sd_ctx->sd->first_stage_model->free_params_buffer();
+    }
+
+    sd_image_t decoded_image = tensor_to_sd_image(decoded);
+    if (decoded_image.data == nullptr ||
+        decoded_image.width != static_cast<uint32_t>(params->width) ||
+        decoded_image.height != static_cast<uint32_t>(params->height) ||
+        decoded_image.channel != 3u) {
+        if (decoded_image.data != nullptr) {
+            free(decoded_image.data);
+        }
+        return fail("the final VAE output does not match the requested RGB canvas");
+    }
+    sd_image_t* result = static_cast<sd_image_t*>(calloc(1u, sizeof(sd_image_t)));
+    if (result == nullptr) {
+        free(decoded_image.data);
+        return fail("allocating the UltraFix result descriptor failed");
+    }
+    result[0] = decoded_image;
+
+    sd_ctx->sd->lora_stat();
+    sd_ctx->sd->image_execution_evidence.mark_generation_completed(
+        false, false, 0.0f, false, 0.0f);
+    evidence->generation_completed = 1u;
+    evidence->cancelled = 0u;
+    evidence->preview_published = 0u;
+    return result;
+}
+
 static std::optional<ImageGenerationLatents> prepare_video_generation_latents(sd_ctx_t* sd_ctx,
                                                                               const sd_vid_gen_params_t* sd_vid_gen_params,
                                                                               GenerationRequest* request) {
diff --git a/src/tokenizers/bpe_tokenizer.cpp b/src/tokenizers/bpe_tokenizer.cpp
index ed4e187..27623b0 100644
