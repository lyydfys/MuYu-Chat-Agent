+// Preserve source names across stages: module filters can hide an adapter's
+// unmatched tensors, including split projections targeting a fused DiT.
+static bool qwen_image_21_loras_are_complete(
+    const StableDiffusionGGML* sd,
+    QwenImage21LoraCoverage* coverage,
+    bool require_all_requested = true) {
+    if (sd == nullptr || sd->version != VERSION_QWEN_IMAGE_2_1 ||
+        sd->requested_lora_ids.empty()) {
+        return true;
+    }
+
+    bool complete = true;
+    const auto inspect = [&](const std::vector<std::shared_ptr<LoraModel>>& models) {
+        for (const auto& model : models) {
+            if (model == nullptr || model->lora_tensors.empty()) {
+                continue;
+            }
+
+            coverage->loaded_ids.insert(model->lora_id);
+            auto& expected = coverage->expected[model->lora_id];
+            auto& applied = coverage->applied[model->lora_id];
+            for (const auto& [name, _] : model->model_loader.get_tensor_storage_map()) {
+                expected.insert(name);
+            }
+            applied.insert(model->applied_lora_tensors.begin(),
+                           model->applied_lora_tensors.end());
+            if (!require_all_requested) {
+                size_t unconsumed_count = 0;
+                std::string first_unconsumed;
+                for (const auto& [name, _] : model->lora_tensors) {
+                    if (model->applied_lora_tensors.find(name) ==
+                        model->applied_lora_tensors.end()) {
+                        if (first_unconsumed.empty()) {
+                            first_unconsumed = name;
+                        }
+                        ++unconsumed_count;
+                    }
+                }
+                if (unconsumed_count != 0) {
+                    complete = false;
+                    LOG_ERROR(
+                        "Qwen Image 2.1 text phase LoRA '%s' consumed %zu/%zu "
+                        "loaded tensors; first unconsumed tensor is '%s'",
+                        model->lora_id.c_str(),
+                        model->lora_tensors.size() - unconsumed_count,
+                        model->lora_tensors.size(), first_unconsumed.c_str());
+                }
+            }
+        }
+    };
+
+    inspect(sd->cond_stage_lora_models);
+    inspect(sd->diffusion_lora_models);
+    inspect(sd->first_stage_lora_models);
+
+    for (const auto& requested_id : sd->requested_lora_ids) {
+        if (coverage->loaded_ids.find(requested_id) == coverage->loaded_ids.end()) {
+            if (require_all_requested) {
+                complete = false;
+                LOG_ERROR(
+                    "Qwen Image 2.1 requested LoRA '%s' loaded no compatible tensors",
+                    requested_id.c_str());
+            }
+            continue;
+        }
+
+        if (!require_all_requested) {
+            continue;
+        }
+        const auto& expected = coverage->expected.at(requested_id);
+        const auto& applied = coverage->applied.at(requested_id);
+        size_t unconsumed_count = 0;
+        std::string first_unconsumed;
+        for (const auto& name : expected) {
+            if (applied.find(name) == applied.end()) {
+                if (first_unconsumed.empty()) {
+                    first_unconsumed = name;
+                }
+                ++unconsumed_count;
+            }
+        }
+        if (unconsumed_count != 0) {
+            complete = false;
+            LOG_ERROR(
+                "Qwen Image 2.1 LoRA '%s' schema mismatch: consumed %zu/%zu "
+                "tensors across text and DiT/VAE phases; first unconsumed "
+                "tensor is '%s'",
+                requested_id.c_str(), expected.size() - unconsumed_count,
+                expected.size(), first_unconsumed.c_str());
+        }
+    }
+    return complete;
+}
