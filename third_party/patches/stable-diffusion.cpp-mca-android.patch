+    const int64_t inversion_started_us = ggml_time_us();
+    for (int index = params->refinement_steps - 1;
+         index >= denoise_start;
+         --index) {
+        if (sd_should_cancel()) {
+            evidence->cancelled = 1u;
+            return nullptr;
+        }
+        const float target_sigma = plan.sigmas[static_cast<size_t>(index)];
+        const float evaluation_sigma = source_sigma > 0.0f
+            ? source_sigma
+            : target_sigma;
+        if (!std::isfinite(target_sigma) || target_sigma <= source_sigma ||
+            !std::isfinite(evaluation_sigma) || evaluation_sigma <= 0.0f) {
+            return fail("the inversion ladder is not strictly increasing in noise level");
+        }
+        ++evidence->ddim_inversion_invocation_count;
+        StableDiffusionGGML::UltraFixPrediction prediction =
+            sd_ctx->sd->ultrafix_tiled_prediction(
+                inverted,
+                evaluation_sigma,
+                embeds.cond,
+                SDCondition(),
+                1.0f,
+                params->tile_size,
+                params->tile_overlap,
+                params->width,
+                params->height,
+                true);
+        if (prediction.denoised.empty() || prediction.tile_count == 0u ||
+            prediction.denoised.shape() != inverted.shape()) {
+            return fail("a tiled DDIM inversion evaluation failed");
+        }
+        sd::Tensor<float> epsilon =
+            (inverted - prediction.denoised) / evaluation_sigma;
+        sd::Tensor<float> x0_prediction = inverted - epsilon * source_sigma;
+        inverted = x0_prediction + epsilon * target_sigma;
+        source_sigma = target_sigma;
+        ++evidence->ddim_inversion_success_count;
+        ++evidence->ddim_inversion_step_count;
+        evidence->ddim_inversion_tile_count += prediction.tile_count;
+        evidence->ddim_inversion_tile_success_count += prediction.tile_count;
+        const int inversion_completed_step = params->refinement_steps - index;
+        sd_ctx->sd->report_auxiliary_progress(
+            inversion_completed_step,
+            static_cast<size_t>(params->inversion_steps) * 2u,
+            inversion_started_us);
+    }
+    if (evidence->ddim_inversion_step_count !=
+        static_cast<uint64_t>(params->inversion_steps) ||
+        std::fabs(source_sigma - plan.sigmas[static_cast<size_t>(denoise_start)]) >
+            std::max(1.0e-6f, std::fabs(source_sigma) * 1.0e-5f)) {
+        return fail("the DDIM inversion ladder did not reach the requested start sigma");
+    }
+
+    if (latents.init_latent.dim() != 4 ||
+        latents.init_latent.shape()[0] <= 0 ||
+        latents.init_latent.shape()[1] <= 0 ||
+        latents.init_latent.shape()[2] <= 0 ||
+        latents.init_latent.shape()[3] <= 0) {
+        return fail("the UltraFix latent does not expose a canonical four-dimensional shape");
+    }
+    const mca::image::SpatialTensorShape ultra_fix_latent_shape{
+        static_cast<size_t>(latents.init_latent.shape()[3]),
+        static_cast<size_t>(latents.init_latent.shape()[2]),
+        static_cast<size_t>(latents.init_latent.shape()[1]),
+        static_cast<size_t>(latents.init_latent.shape()[0]),
+        mca::image::SpatialTensorLayout::Nchw,
+    };
+    std::vector<float> ultra_fix_equivalent_noise;
+    std::string ultra_fix_quality_error;
+    if (params->inversion_steps > 1) {
+        const mca::image::UltraFixNoiseLevel inverted_level{
+            1.0,
+            static_cast<double>(source_sigma),
+            1.0 / std::sqrt(1.0 +
+                static_cast<double>(source_sigma) * source_sigma),
+        };
+        if (!mca::image::ultrafix_equivalent_noise(
+                latents.init_latent.values(),
+                inverted.values(),
+                inverted_level,
+                &ultra_fix_equivalent_noise,
+                &ultra_fix_quality_error)) {
+            return fail(ultra_fix_quality_error.c_str());
+        }
+        evidence->trajectory_noise_checksum =
+            mca::image::ultrafix_tensor_checksum(ultra_fix_equivalent_noise);
+        if (evidence->trajectory_noise_checksum == 0u) {
+            return fail("the UltraFix inverted trajectory lacks checksum evidence");
+        }
+    }
+
+    std::vector<float> denoise_sigmas(
+        plan.sigmas.begin() + denoise_start,
+        plan.sigmas.end());
+    if (denoise_sigmas.size() !=
+        static_cast<size_t>(params->inversion_steps + 1)) {
+        return fail("the strength-derived denoising schedule has the wrong length");
+    }
+    sd_ctx->sd->image_execution_evidence.record_sampling_pass();
+    const int64_t sample_started_us = ggml_time_us();
+    std::vector<mca::image::UltraFixQualitySchedule> quality_schedules(
+        static_cast<size_t>(params->inversion_steps));
+    auto tiled_denoise = [&](const sd::Tensor<float>& x,
+                             float sigma,
+                             int step) -> sd::guidance::GuiderOutput {
+        sd::guidance::GuiderOutput output;
+        if (sd_should_cancel()) {
+            evidence->cancelled = 1u;
+            return output;
+        }
+        ++evidence->tiled_unet_invocation_count;
+        StableDiffusionGGML::UltraFixPrediction prediction =
+            sd_ctx->sd->ultrafix_tiled_prediction(
+                x,
+                sigma,
+                embeds.cond,
+                embeds.uncond,
+                params->cfg_scale,
+                params->tile_size,
+                params->tile_overlap,
+                params->width,
+                params->height,
+                false);
+        if (prediction.denoised.empty() || prediction.tile_count == 0u ||
+            !std::isfinite(prediction.model_timestep) ||
+            prediction.denoised.shape() != x.shape()) {
+            return output;
+        }
+        const int physical_step = std::abs(step) - 1;
+        if (physical_step < 0 || physical_step >= params->inversion_steps) {
+            ultra_fix_quality_error =
+                "the UltraFix sampler reported an out-of-range refinement step";
+            return output;
+        }
+        const bool has_next_step = physical_step + 1 < params->inversion_steps;
+        mca::image::UltraFixQualitySchedule quality_schedule;
+        if (!mca::image::resolve_ultrafix_quality_schedule(
+                static_cast<double>(prediction.model_timestep),
+                has_next_step,
+                &quality_schedule,
+                &ultra_fix_quality_error)) {
+            return output;
+        }
+        quality_schedules[static_cast<size_t>(physical_step)] = quality_schedule;
+        if (has_next_step) {
+            ++evidence->quality_step_evaluation_count;
+        }
+        if (quality_schedule.evaluate_noise_injection) {
+            if (sd_should_cancel() || !(sigma > 0.0f)) {
+                evidence->cancelled = sd_should_cancel() ? 1u : 0u;
+                ultra_fix_quality_error =
+                    "UltraFix quality-noise injection was cancelled or received zero sigma";
+                return output;
+            }
+            std::vector<float> epsilon(prediction.denoised.values().size(), 0.0f);
+            for (size_t index = 0u; index < epsilon.size(); ++index) {
+                epsilon[index] =
+                    (x.values()[index] - prediction.denoised.values()[index]) / sigma;
+            }
+            std::vector<float> mixed_epsilon;
+            uint64_t gaussian_checksum = 0u;
+            uint64_t mixed_checksum = 0u;
+            if (!mca::image::ultrafix_inject_spherical_noise(
+                    epsilon,
+                    static_cast<uint64_t>(params->seed),
+                    static_cast<uint32_t>(physical_step),
+                    quality_schedule.noise_injection_fraction,
+                    &mixed_epsilon,
+                    &gaussian_checksum,
+                    &mixed_checksum,
+                    &ultra_fix_quality_error)) {
+                return output;
+            }
+            for (size_t index = 0u; index < mixed_epsilon.size(); ++index) {
+                prediction.denoised.values()[index] =
+                    x.values()[index] - mixed_epsilon[index] * sigma;
+            }
+            evidence->noise_injection_checksum =
+                mca::image::ultrafix_accumulate_checksum(
+                    evidence->noise_injection_checksum,
+                    static_cast<uint32_t>(physical_step),
+                    gaussian_checksum);
+            evidence->noise_injection_checksum =
+                mca::image::ultrafix_accumulate_checksum(
+                    evidence->noise_injection_checksum,
+                    static_cast<uint32_t>(physical_step),
+                    mixed_checksum);
