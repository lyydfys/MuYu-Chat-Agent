+SD_API sd_image_t* sd_generate_ultrafix(
+    sd_ctx_t* sd_ctx,
+    const sd_ultrafix_params_t* params,
+    sd_ultrafix_execution_evidence_t* evidence) {
+    if (evidence == nullptr) {
+        LOG_ERROR("UltraFix requires a stage-specific evidence destination");
+        return nullptr;
+    }
+    *evidence            = {};
+    evidence->version    = SD_ULTRAFIX_EXECUTION_EVIDENCE_VERSION;
+    evidence->cancelled  = sd_should_cancel() ? 1u : 0u;
+    if (sd_ctx == nullptr || sd_ctx->sd == nullptr || params == nullptr) {
+        LOG_ERROR("UltraFix requires a loaded stable-diffusion context and request");
+        return nullptr;
+    }
+
+    evidence->source_width     = params->init_image.width;
+    evidence->source_height    = params->init_image.height;
+    evidence->target_width     = static_cast<uint32_t>(std::max(params->width, 0));
+    evidence->target_height    = static_cast<uint32_t>(std::max(params->height, 0));
+    evidence->tile_size        = static_cast<uint32_t>(std::max(params->tile_size, 0));
+    evidence->tile_overlap     = params->tile_overlap;
+    evidence->inversion_steps  = static_cast<uint32_t>(std::max(params->inversion_steps, 0));
+    evidence->refinement_steps = static_cast<uint32_t>(std::max(params->refinement_steps, 0));
+    evidence->denoise_step_count = evidence->inversion_steps;
+    evidence->sample_method    = static_cast<uint32_t>(params->sample_method);
+    evidence->scheduler        = static_cast<uint32_t>(params->scheduler);
+    evidence->source_fit       = static_cast<uint32_t>(params->source_fit);
+    evidence->noise_injection_seed = static_cast<uint64_t>(params->seed);
+
+    const auto fail = [&](const char* message) -> sd_image_t* {
+        evidence->cancelled = sd_should_cancel() ? 1u : 0u;
+        LOG_ERROR("UltraFix failed: %s", message);
+        return nullptr;
+    };
+    if (!sd_ctx->sd->supports_ultrafix()) {
+        return fail("the loaded topology does not expose VAE encode, standard UNet, and VAE decode");
+    }
+    if (params->prompt == nullptr || params->prompt[0] == '\0' ||
+        params->init_image.data == nullptr || params->init_image.channel != 3u ||
+        params->init_image.width == 0u || params->init_image.height == 0u ||
+        params->width <= 0 || params->height <= 0) {
+        return fail("UltraFix requires a non-empty three-channel source and target canvas");
+    }
+    const uint64_t target_pixels = static_cast<uint64_t>(params->width) *
+                                   static_cast<uint64_t>(params->height);
+    if (params->width > 8192 || params->height > 8192 ||
+        target_pixels > 64u * 1024u * 1024u) {
+        return fail("the target canvas exceeds the bounded UltraFix image contract");
+    }
+    if (params->init_image.width > static_cast<uint32_t>(params->width) ||
+        params->init_image.height > static_cast<uint32_t>(params->height)) {
+        return fail("UltraFix does not shrink either source image axis");
+    }
+    if (params->source_fit != SD_ULTRAFIX_SOURCE_FIT_COVER_CENTER) {
+        return fail("UltraFix requires the aspect-preserving center-cover source fit");
+    }
+    if (!std::isfinite(params->strength) || params->strength <= 0.0f ||
+        params->strength > 1.0f || params->refinement_steps < 1 ||
+        params->refinement_steps > 100 || params->inversion_steps < 1 ||
+        params->inversion_steps > params->refinement_steps) {
+        return fail("strength or step counts are outside the UltraFix contract");
+    }
+    const int denoise_begin = params->refinement_steps - params->inversion_steps;
+    const double strength_begin =
+        static_cast<double>(params->refinement_steps) *
+        (1.0 - static_cast<double>(params->strength));
+    const double strength_boundary_tolerance = std::max(
+        1.0e-6,
+        static_cast<double>(params->refinement_steps) *
+            static_cast<double>(std::numeric_limits<float>::epsilon()) * 4.0);
+    if (strength_begin + strength_boundary_tolerance < static_cast<double>(denoise_begin) ||
+        strength_begin >= static_cast<double>(denoise_begin + 1) +
+            strength_boundary_tolerance) {
+        return fail("inversion steps do not match the strength-derived denoising tail");
+    }
+    if (params->tile_size < 128 || params->tile_size > 2048 ||
+        params->tile_size > std::min(params->width, params->height) ||
+        params->tile_size % 8 != 0 || !std::isfinite(params->tile_overlap) ||
+        params->tile_overlap < 0.0f || params->tile_overlap > 0.5f) {
+        return fail("tile size or overlap is outside the UltraFix contract");
+    }
+    if (!std::isfinite(params->cfg_scale) || params->cfg_scale < 0.0f ||
+        params->cfg_scale > 30.0f || !std::isfinite(params->eta) ||
+        params->eta < 0.0f) {
