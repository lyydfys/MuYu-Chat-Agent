+    condition->prompt = params->prompt;
+    condition->negative_prompt = SAFE_STR(params->negative_prompt);
+    condition->width = params->width;
+    condition->height = params->height;
+    condition->clip_skip = params->clip_skip;
+    condition->txt_cfg = params->sample_params.guidance.txt_cfg;
+    condition->lora_count = params->lora_count;
+
+    ConditionerParams conditioner_params;
+    conditioner_params.text = condition->prompt;
+    conditioner_params.clip_skip = condition->clip_skip;
+    conditioner_params.width = condition->width;
+    conditioner_params.height = condition->height;
+    conditioner_params.zero_out_masked = false;
+    ConditioningExecutionEvidence positive_evidence;
+    conditioner_params.execution_evidence = &positive_evidence;
+    condition->positive = sd_ctx->sd->cond_stage_model->get_learned_condition(
