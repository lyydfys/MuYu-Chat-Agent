+static std::unordered_set<std::string> qwen_image_21_lora_ids(
+    const StableDiffusionGGML* sd, bool applied_only) {
+    std::unordered_set<std::string> result;
+    const auto collect = [&](const std::vector<std::shared_ptr<LoraModel>>& models) {
+        for (const auto& model : models) {
+            if (model && (applied_only ? !model->applied_lora_tensors.empty()
+                                       : !model->lora_tensors.empty())) {
+                result.insert(model->lora_id);
+            }
+        }
+    };
+    collect(sd->cond_stage_lora_models);
+    collect(sd->diffusion_lora_models);
+    collect(sd->first_stage_lora_models);
+    return result;
+}
