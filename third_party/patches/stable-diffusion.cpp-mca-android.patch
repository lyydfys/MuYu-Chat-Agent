+    std::vector<int> ultrafix_tile_starts(int length,
+                                          int tile,
+                                          float overlap,
+                                          int alignment) const {
+        std::vector<int> starts;
+        if (length <= 0 || tile <= 0 || tile > length || alignment <= 0 ||
+            length % alignment != 0 || tile % alignment != 0) {
+            return starts;
+        }
+        if (length == tile) {
+            starts.push_back(0);
+            return starts;
+        }
+        int stride = static_cast<int>(std::floor(static_cast<float>(tile) * (1.0f - overlap)));
+        stride     = std::max(alignment, (stride / alignment) * alignment);
+        int cursor = 0;
+        while (true) {
+            starts.push_back(cursor);
+            if (cursor + tile >= length) {
+                break;
+            }
+            int next = std::min(cursor + stride, length - tile);
+            next     = (next / alignment) * alignment;
+            if (next <= cursor) {
+                starts.clear();
+                return starts;
+            }
+            cursor = next;
+        }
+        return starts;
+    }
+
+    SDCondition ultrafix_tile_condition(const SDCondition& source,
+                                         int tile_x,
+                                         int tile_y,
+                                         int tile_pixels,
+                                         int full_width,
+                                         int full_height) const {
+        SDCondition result = source;
+        if (!sd_version_is_sdxl(version) || source.c_vector.numel() < 1536) {
+            return result;
+        }
+        const int embedding_dim = 256;
+        const int64_t time_id_elements = 6 * embedding_dim;
+        const int64_t offset = result.c_vector.numel() - time_id_elements;
+        const float scale = 1024.0f /
+                            static_cast<float>(std::max(full_width, full_height));
+        const std::array<std::vector<float>, 3> groups = {
+            std::vector<float>{std::round(static_cast<float>(full_height) * scale),
+                               std::round(static_cast<float>(full_width) * scale)},
+            std::vector<float>{std::round(static_cast<float>(tile_y) * scale),
+                               std::round(static_cast<float>(tile_x) * scale)},
+            std::vector<float>{static_cast<float>(tile_pixels),
+                               static_cast<float>(tile_pixels)}};
+        int64_t write_offset = offset;
+        for (const auto& values : groups) {
+            sd::Tensor<float> embedding;
+            set_timestep_embedding(values, &embedding, embedding_dim);
+            std::copy(embedding.values().begin(),
+                      embedding.values().end(),
+                      result.c_vector.values().begin() + write_offset);
+            write_offset += embedding.numel();
+        }
+        GGML_ASSERT(write_offset == result.c_vector.numel());
+        return result;
+    }
