+    std::vector<int> ultrafix_tile_starts(int length,
+                                          int tile,
+                                          float overlap,
+                                          int alignment) const {
+        std::vector<int> starts;
+        if (length <= 0 || tile <= 0 || tile > length || alignment <= 0 ||
+            length % alignment != 0 || tile % alignment != 0) {
+            return starts;
+        }
+        if (length == tile) {
+            starts.push_back(0);
+            return starts;
+        }
+        int stride = static_cast<int>(std::floor(static_cast<float>(tile) * (1.0f - overlap)));
+        stride     = std::max(alignment, (stride / alignment) * alignment);
+        int cursor = 0;
+        while (true) {
+            starts.push_back(cursor);
+            if (cursor + tile >= length) {
+                break;
+            }
+            int next = std::min(cursor + stride, length - tile);
+            next     = (next / alignment) * alignment;
+            if (next <= cursor) {
+                starts.clear();
+                return starts;
+            }
+            cursor = next;
+        }
+        return starts;
+    }
