+                               std::round(static_cast<float>(tile_x) * scale)},
+            std::vector<float>{static_cast<float>(tile_pixels),
+                               static_cast<float>(tile_pixels)}};
+        int64_t write_offset = offset;
+        for (const auto& values : groups) {
+            sd::Tensor<float> embedding;
+            set_timestep_embedding(values, &embedding, embedding_dim);
+            std::copy(embedding.values().begin(),
+                      embedding.values().end(),
+                      result.c_vector.values().begin() + write_offset);
+            write_offset += embedding.numel();
+        }
+        GGML_ASSERT(write_offset == result.c_vector.numel());
+        return result;
+    }
+
+    UltraFixPrediction ultrafix_tiled_prediction(const sd::Tensor<float>& x,
+                                                  float sigma,
+                                                  const SDCondition& cond,
+                                                  const SDCondition& uncond,
+                                                  float cfg_scale,
+                                                  int tile_pixels,
+                                                  float overlap,
+                                                  int full_width,
+                                                  int full_height,
+                                                  bool guidance_free) {
+        UltraFixPrediction result;
+        if (!supports_ultrafix() || x.dim() != 4 || x.empty() ||
+            !std::isfinite(sigma) || sigma < 0.0f) {
+            return result;
+        }
+        const int vae_scale = get_vae_scale_factor();
+        const int tile_latent = tile_pixels / vae_scale;
+        // SDXL UNet tiles only require factor-4 latent origins; SD1/2 require
+        // factor-8.  The full-image latent still follows the model's ordinary
+        // generation alignment, while edge-clamped tile origins use the
+        // narrowest topology-safe grid so custom SDXL aspect ratios remain valid.
+        const int alignment = sd_version_is_sdxl(version) ? 4 : 8;
+        const int latent_width = static_cast<int>(x.shape()[0]);
+        const int latent_height = static_cast<int>(x.shape()[1]);
+        const auto x_starts = ultrafix_tile_starts(
+            latent_width, tile_latent, overlap, alignment);
+        const auto y_starts = ultrafix_tile_starts(
+            latent_height, tile_latent, overlap, alignment);
+        if (x_starts.empty() || y_starts.empty()) {
+            return result;
+        }
+
+        const std::vector<float> scalings = denoiser->get_scalings(sigma);
+        if (scalings.size() != 3u) {
+            return result;
+        }
+        const float c_skip = scalings[0];
+        const float c_out  = scalings[1];
+        const float c_in   = scalings[2];
+        const std::vector<float> timestep_values = prepare_sample_timesteps(sigma, 0);
+        if (timestep_values.empty() || !std::isfinite(timestep_values.front())) {
+            return result;
+        }
+        result.model_timestep = timestep_values.front();
+        sd::Tensor<float> timestep_tensor(
+            {static_cast<int64_t>(timestep_values.size())}, timestep_values);
+        std::vector<sd::Tensor<float>> no_controls;
+
+        auto run_condition = [&](const sd::Tensor<float>& tile,
+                                 const SDCondition& condition,
+                                 DiffusionExecutionBranch branch,
+                                 int tile_x,
+                                 int tile_y) -> sd::Tensor<float> {
+            SDCondition tile_condition = ultrafix_tile_condition(
+                condition,
+                tile_x * vae_scale,
+                tile_y * vae_scale,
+                tile_pixels,
+                full_width,
+                full_height);
+            sd::Tensor<float> noised_input = tile * c_in;
+            DiffusionParams diffusion_params;
+            diffusion_params.x = &noised_input;
+            diffusion_params.timesteps = &timestep_tensor;
+            diffusion_params.context = tile_condition.c_crossattn.empty()
+                                           ? nullptr
+                                           : &tile_condition.c_crossattn;
+            diffusion_params.c_concat = tile_condition.c_concat.empty()
+                                            ? nullptr
+                                            : &tile_condition.c_concat;
+            diffusion_params.y = tile_condition.c_vector.empty()
+                                     ? nullptr
+                                     : &tile_condition.c_vector;
+            diffusion_params.ref_latents = tile_condition.c_ref_images.empty()
+                                               ? nullptr
+                                               : &tile_condition.c_ref_images;
+            diffusion_params.increase_ref_index = false;
+            diffusion_params.extra = UNetDiffusionExtra{-1, &no_controls, 0.0f};
+            if (sd_should_cancel()) {
+                return {};
+            }
+            sd::Tensor<float> output = diffusion_model->compute(n_threads, diffusion_params);
+            if (!output.empty()) {
+                image_execution_evidence.record_diffusion_compute(branch);
+            }
+            return output;
+        };
+
+        std::vector<float> blend_weights(
+            static_cast<size_t>(latent_width) * static_cast<size_t>(latent_height),
+            0.0f);
+        const auto smootherstep = [](float value) {
+            const float x = std::clamp(value, 0.0f, 1.0f);
+            return x * x * x * (x * (x * 6.0f - 15.0f) + 10.0f);
+        };
+        for (size_t tile_y_index = 0; tile_y_index < y_starts.size(); ++tile_y_index) {
+            const int tile_y = y_starts[tile_y_index];
+            const int top_overlap = tile_y_index > 0
+                ? y_starts[tile_y_index - 1] + tile_latent - tile_y
+                : 0;
+            const int bottom_overlap = tile_y_index + 1 < y_starts.size()
+                ? tile_y + tile_latent - y_starts[tile_y_index + 1]
+                : 0;
+            for (size_t tile_x_index = 0; tile_x_index < x_starts.size(); ++tile_x_index) {
+                const int tile_x = x_starts[tile_x_index];
+                const int left_overlap = tile_x_index > 0
+                    ? x_starts[tile_x_index - 1] + tile_latent - tile_x
+                    : 0;
+                const int right_overlap = tile_x_index + 1 < x_starts.size()
+                    ? tile_x + tile_latent - x_starts[tile_x_index + 1]
+                    : 0;
+                if (sd_should_cancel()) {
+                    return {};
+                }
+                const sd::Tensor<float> tile = sd_tensor_split_2d(
+                    x, tile_latent, tile_latent, tile_x, tile_y);
+                sd::Tensor<float> cond_output = run_condition(
+                    tile, cond, DiffusionExecutionBranch::POSITIVE, tile_x, tile_y);
+                if (cond_output.empty()) {
+                    return {};
+                }
+                sd::Tensor<float> raw = std::move(cond_output);
+                if (!guidance_free && !uncond.empty()) {
+                    sd::Tensor<float> uncond_output = run_condition(
+                        tile, uncond, DiffusionExecutionBranch::NEGATIVE, tile_x, tile_y);
+                    if (uncond_output.empty()) {
+                        return {};
+                    }
+                    raw = uncond_output + (raw - uncond_output) * cfg_scale;
+                }
+                sd::Tensor<float> denoised = raw * c_out + tile * c_skip;
+                if (result.raw.empty()) {
+                    std::vector<int64_t> shape = raw.shape();
+                    shape[0] = latent_width;
+                    shape[1] = latent_height;
+                    result.raw = sd::Tensor<float>::zeros(shape);
+                    result.denoised = sd::Tensor<float>::zeros(std::move(shape));
+                }
+                const int64_t tile_plane =
+                    static_cast<int64_t>(tile_latent) * tile_latent;
+                const int64_t full_plane =
+                    static_cast<int64_t>(latent_width) * latent_height;
+                const int64_t planes = raw.numel() / tile_plane;
+                for (int local_y = 0; local_y < tile_latent; ++local_y) {
+                    float weight_y = 1.0f;
+                    if (top_overlap > 0 && local_y < top_overlap) {
+                        weight_y = std::min(
+                            weight_y,
+                            smootherstep(static_cast<float>(local_y + 1) /
+                                         static_cast<float>(top_overlap + 1)));
+                    }
+                    if (bottom_overlap > 0 &&
+                        local_y >= tile_latent - bottom_overlap) {
+                        weight_y = std::min(
+                            weight_y,
+                            smootherstep(static_cast<float>(tile_latent - local_y) /
+                                         static_cast<float>(bottom_overlap + 1)));
+                    }
+                    for (int local_x = 0; local_x < tile_latent; ++local_x) {
+                        float weight_x = 1.0f;
+                        if (left_overlap > 0 && local_x < left_overlap) {
+                            weight_x = std::min(
+                                weight_x,
+                                smootherstep(static_cast<float>(local_x + 1) /
+                                             static_cast<float>(left_overlap + 1)));
+                        }
+                        if (right_overlap > 0 &&
+                            local_x >= tile_latent - right_overlap) {
+                            weight_x = std::min(
+                                weight_x,
+                                smootherstep(static_cast<float>(tile_latent - local_x) /
+                                             static_cast<float>(right_overlap + 1)));
+                        }
+                        const float weight = weight_x * weight_y;
+                        const int64_t tile_offset =
+                            local_x + static_cast<int64_t>(tile_latent) * local_y;
+                        const int64_t full_offset =
+                            (tile_x + local_x) +
+                            static_cast<int64_t>(latent_width) * (tile_y + local_y);
+                        blend_weights[static_cast<size_t>(full_offset)] += weight;
+                        for (int64_t plane = 0; plane < planes; ++plane) {
+                            result.raw[plane * full_plane + full_offset] +=
+                                raw[plane * tile_plane + tile_offset] * weight;
+                            result.denoised[plane * full_plane + full_offset] +=
+                                denoised[plane * tile_plane + tile_offset] * weight;
+                        }
+                    }
+                }
+                ++result.tile_count;
+            }
+        }
+        if (result.raw.empty()) {
+            return result;
+        }
+        const int64_t full_plane =
+            static_cast<int64_t>(latent_width) * latent_height;
+        const int64_t planes = result.raw.numel() / full_plane;
+        for (int64_t offset = 0; offset < full_plane; ++offset) {
+            const float weight = blend_weights[static_cast<size_t>(offset)];
+            if (!(weight > 0.0f) || !std::isfinite(weight)) {
+                return {};
+            }
+            for (int64_t plane = 0; plane < planes; ++plane) {
+                result.raw[plane * full_plane + offset] /= weight;
+                result.denoised[plane * full_plane + offset] /= weight;
+            }
+        }
+        return result;
+    }
