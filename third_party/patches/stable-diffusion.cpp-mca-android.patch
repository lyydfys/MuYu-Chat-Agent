+SD_API sd_image_t* generate_image(sd_ctx_t* sd_ctx, const sd_img_gen_params_t* params) {
+    if (sd_ctx == nullptr || sd_ctx->sd == nullptr ||
+        sd_ctx->sd->qwen_image_21_phase != SD_QWEN_IMAGE_21_PHASE_FULL) {
