+SD_API sd_image_t* sd_generate_image_with_qwen_image_21_condition(
+    sd_ctx_t* sd_ctx, const sd_img_gen_params_t* params,
+    const sd_qwen_image_21_condition_t* condition) {
+    if (sd_ctx == nullptr || sd_ctx->sd == nullptr || params == nullptr ||
+        condition == nullptr ||
+        sd_ctx->sd->qwen_image_21_phase != SD_QWEN_IMAGE_21_PHASE_DIFFUSION_VAE ||
+        sd_ctx->sd->version != VERSION_QWEN_IMAGE_2_1 ||
+        sd_ctx->sd->cond_stage_model != nullptr ||
+        sd_ctx->sd->diffusion_model == nullptr ||
+        sd_ctx->sd->first_stage_model == nullptr ||
+        condition->evidence.version != SD_IMAGE_EXECUTION_EVIDENCE_VERSION ||
+        condition->evidence.positive_conditioning_observed == 0 ||
+        condition->evidence_artifact.size() !=
+            condition->evidence.conditioning_artifact_byte_count ||
+        condition->prompt != SAFE_STR(params->prompt) ||
+        condition->negative_prompt != SAFE_STR(params->negative_prompt) ||
+        condition->width != params->width || condition->height != params->height ||
+        condition->clip_skip != params->clip_skip ||
+        condition->txt_cfg != params->sample_params.guidance.txt_cfg ||
+        condition->lora_count != params->lora_count ||
+        ((condition->txt_cfg != 1.f) != !condition->negative.empty())) {
+        LOG_ERROR("Qwen Image 2.1 staged condition does not match generation request");
+        return nullptr;
+    }
+    auto qwen_runner = std::dynamic_pointer_cast<Qwen::QwenImage21Runner>(sd_ctx->sd->diffusion_model);
+    if (!qwen_runner || condition->positive.c_crossattn.shape()[0] != qwen_runner->context_dim() ||
+        (!condition->negative.empty() && condition->negative.c_crossattn.shape()[0] != qwen_runner->context_dim())) {
+        LOG_ERROR("Qwen Image 2.1 staged condition hidden size does not match DiT context");
+        return nullptr;
+    }
+    return generate_image_internal(sd_ctx, params, condition);
+}
