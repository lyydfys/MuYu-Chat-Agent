 // A simple C wrapper of tokenzier library
+//
+// MCA R1 (audit fix): every fallible operation returns Result and every
+// extern "C" entry point reports a failure through an explicit handle/error
+// instead of unwinding a panic across the C ABI. The previous revision called
+// `Tokenizer::from_str(json).unwrap()`, so a tokenizer.json that passes the C++
+// structural checks but cannot build a real tokenizer (for example
+// {"model":{"type":"BPE"}} with no vocab/merges) aborted the whole process:
+// a Rust panic cannot unwind out of `extern "C"`, and on `panic=abort` builds
+// no catch layer in C++, Kotlin or Rust can convert it into an error.
 use ahash::AHashMap;
 use serde_json::Value;
+use std::ffi::CString;
+use std::panic::{catch_unwind, AssertUnwindSafe};
 use std::str::FromStr;
+use std::sync::Mutex;
 use tokenizers::models::bpe::BPE;
 use tokenizers::pre_tokenizers::byte_level::ByteLevel;
 use tokenizers::tokenizer::Tokenizer;
@@ -19,14 +31,84 @@ pub type Merges = Vec<(String, String)>;
 pub struct TokenizerEncodeResult {
     token_ids: *mut u32,
     len: usize,
+    // 0 on success. Non-zero means the call was refused; token_ids is null,
+    // len is 0 and tokenizers_last_error() carries the readable reason.
+    error_code: i32,
+}
+
+/// Readable reason for the most recent refusal. Stored as a CString so the
+/// pointer handed to C stays valid until the next refusal.
+static LAST_ERROR: Mutex<Option<CString>> = Mutex::new(None);
+
+static EMPTY_ERROR: [u8; 1] = [0];
+
+fn set_last_error(message: impl Into<String>) {
+    let text = message.into().replace('\0', " ");
+    if let Ok(mut slot) = LAST_ERROR.lock() {
+        *slot = CString::new(text).ok();
+    }
+}
+
+fn clear_last_error() {
+    if let Ok(mut slot) = LAST_ERROR.lock() {
+        *slot = None;
+    }
+}
+
+/// Backstop only. The primary mechanism is that no fallible path in this file
+/// panics: the constructors, encode, encode_batch and decode all return Result
+/// and report failures through error_code or a null handle. This wrapper exists
+/// for a panic raised *inside* the upstream tokenizers crate, and it is only
+/// effective while the crate is compiled with the default `panic = "unwind"`
+/// strategy (the vendored crate declares no [profile] and the vendor CMake
+/// passes no -Cpanic=abort), so it must never be treated as the fix itself.
+fn backstop<T>(context: &str, fallback: T, body: impl FnOnce() -> T) -> T {
+    match catch_unwind(AssertUnwindSafe(body)) {
+        Ok(value) => value,
+        Err(payload) => {
+            set_last_error(format!("{}: {}", context, panic_text(&*payload)));
+            fallback
+        }
+    }
+}
+
+fn panic_text(payload: &(dyn std::any::Any + Send)) -> String {
+    if let Some(text) = payload.downcast_ref::<&str>() {
+        return (*text).to_string();
+    }
+    if let Some(text) = payload.downcast_ref::<String>() {
+        return text.clone();
+    }
+    "unexpected panic".to_string()
+}
+
+/// Writes a refusal so the C side never reads a stale or null result silently.
+unsafe fn write_error_result(out_result: *mut TokenizerEncodeResult) {
+    *out_result = TokenizerEncodeResult {
+        token_ids: std::ptr::null_mut(),
+        len: 0,
+        error_code: 1,
+    };
+}
+
+unsafe fn write_ok_result(encoded: Vec<u32>, out_result: *mut TokenizerEncodeResult) {
+    let encoded_len = encoded.len();
+    *out_result = TokenizerEncodeResult {
+        token_ids: Box::into_raw(encoded.into_boxed_slice()) as *mut u32,
+        len: encoded_len,
+        error_code: 0,
+    };
 }
 
