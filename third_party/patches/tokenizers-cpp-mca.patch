diff --git a/CMakeLists.txt b/CMakeLists.txt
index 65bfd26980c9ea7c3fcbd00038e4e73280e13428..5cd91b4c1dceb1182d72c49395b62c8f5800ae51 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -159,6 +159,20 @@ add_custom_command(
   RUSTFLAGS="${TOKENIZERS_CPP_RUST_FLAGS}"
   ${CARGO_EXECUTABLE} build ${TOKENIZERS_CPP_CARGO_FLAGS}
   WORKING_DIRECTORY ${TOKENIZERS_CPP_CARGO_SOURCE_PATH}
+  # Without DEPENDS this command had only an OUTPUT, so cargo was re-run ONLY when the
+  # output file happened to be missing. Editing rust/src/lib.rs therefore did not trigger
+  # a rebuild, and a STALE Rust archive was silently reused while the C++ side was rebuilt
+  # correctly through add_library's own source dependencies. The result was a link failure
+  # that gave no hint that half the dependency was old:
+  #   ld.lld: error: undefined symbol: tokenizers_last_error
+  #     >>> huggingface_tokenizer.cc.o:(tokenizers::LastError()) in archive libtokenizers_cpp.a
+  # Declaring the Rust inputs makes that stale-artefact reuse impossible.
+  # (Before this was in place, the workaround was to delete the stale archive and the cargo
+  #  fingerprint by hand after touching any Rust glue.)
+  DEPENDS
+  ${TOKENIZERS_CPP_CARGO_SOURCE_PATH}/src/lib.rs
+  ${TOKENIZERS_CPP_CARGO_SOURCE_PATH}/Cargo.toml
+  ${TOKENIZERS_CPP_CARGO_SOURCE_PATH}/Cargo.lock
   POST_BUILD COMMAND
   ${CMAKE_COMMAND} -E copy
   ${TOKENIZERS_RUST_LIB} "${CMAKE_CURRENT_BINARY_DIR}"
