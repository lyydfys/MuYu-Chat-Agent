<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-sdk tools:overrideLibrary="com.geniex.sdk" />

    <application
        android:name=".McaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MuYuChatAgent">

        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />

        <service
            android:name="com.muyuchat.api.local.LocalLlmService"
            android:exported="false" />

        <service
            android:name=".LocalImageWorkerService"
            android:exported="false"
            android:process=":local_image" />

        <!-- SDXL V75 archive contexts are split into disposable processes.
             Physical HTP transport is selected dynamically; encoder, UNet,
             and decoder must die in order, and no graph shares an unload lifecycle. -->
        <service
            android:name=".SdxlEncoderWorkerService"
            android:exported="false"
            android:process=":sdxl_encoder_v75" />

        <service
            android:name=".SdxlUnetWorkerService"
            android:exported="false"
            android:process=":sdxl_unet_v75" />

        <service
            android:name=".SdxlVaeWorkerService"
            android:exported="false"
            android:process=":sdxl_vae_v75" />

        <!-- Unknown QAIRT bundle/chipset/runtime combinations may only create a
             handle here.  A crash/hang is contained to this disposable process. -->
        <service
            android:name=".QairtDryRunWorkerService"
            android:exported="false"
            android:process=":qairt_smoke" />

        <!-- Every load-bound smart-tuning candidate is reconstructed from a
             persisted pending journal and executed in this disposable process. -->
        <service
            android:name=".TuningProbeWorkerService"
            android:exported="false"
            android:process=":tuning"
            android:stopWithTask="true" />

        <!-- Long-lived ordinary local text runtimes live outside the UI
             process. A native crash or hang is contained here and is surfaced
             to the main process as a Binder/load error. -->
        <service
            android:name=".LocalChatWorkerService"
            android:exported="false"
            android:process=":local_chat"
            android:stopWithTask="true" />

        <service
            android:name=".LocalApiForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_ai_api_server" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/image_share_file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MuYuChatAgent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
