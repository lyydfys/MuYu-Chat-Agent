<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="mca-runtime.db" />
        <exclude domain="database" path="mca-runtime.db-wal" />
        <exclude domain="database" path="mca-runtime.db-shm" />
        <exclude domain="database" path="mca-runtime.db-journal" />
        <exclude domain="database" path="mca.db" />
        <exclude domain="database" path="mca.db-wal" />
        <exclude domain="database" path="mca.db-shm" />
        <exclude domain="database" path="mca.db-journal" />
        <exclude domain="file" path="image_assets" />
        <exclude domain="file" path="image_execution_journal" />
        <exclude domain="file" path="image_generation_inputs" />
        <exclude domain="file" path="image_loras" />
        <exclude domain="file" path="image_upscalers" />
        <exclude domain="file" path="image_models" />
        <exclude domain="external" path="image_models" />
        <exclude domain="file" path="chat_sessions.json" />
        <!-- Agent workspaces hold user-imported snapshots, payloads and artifacts; they move only
             through the explicit Agent export format (architecture 10.2/10.6). -->
        <exclude domain="file" path="agent" />
        <!-- DSH official home/workspace/config/log tree; excluded from both cloud backup and
             device transfer, same reasoning as the app-local backup rules. -->
        <exclude domain="file" path="dsh" />
        <exclude domain="sharedpref" path="mca_api.xml" />
        <exclude domain="sharedpref" path="mca_cloud_api.xml" />
        <exclude domain="sharedpref" path="mca_web_search.xml" />
        <exclude domain="sharedpref" path="mca_web_search_diagnostics.xml" />
        <exclude domain="sharedpref" path="mca_local_api_idempotency_journal.xml" />
        <exclude domain="sharedpref" path="mca_local_image_models.xml" />
        <exclude domain="sharedpref" path="image_loras_v1.xml" />
        <exclude domain="sharedpref" path="image_upscalers_v1.xml" />
        <exclude domain="sharedpref" path="image_upscaler_product_selection_v1.xml" />
        <exclude domain="sharedpref" path="mca_image_generation_ui_parameters.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="mca-runtime.db" />
        <exclude domain="database" path="mca-runtime.db-wal" />
        <exclude domain="database" path="mca-runtime.db-shm" />
        <exclude domain="database" path="mca-runtime.db-journal" />
        <exclude domain="database" path="mca.db" />
        <exclude domain="database" path="mca.db-wal" />
        <exclude domain="database" path="mca.db-shm" />
        <exclude domain="database" path="mca.db-journal" />
        <exclude domain="file" path="image_assets" />
        <exclude domain="file" path="image_execution_journal" />
        <exclude domain="file" path="image_generation_inputs" />
        <exclude domain="file" path="image_loras" />
        <exclude domain="file" path="image_upscalers" />
        <exclude domain="file" path="image_models" />
        <exclude domain="external" path="image_models" />
        <exclude domain="file" path="chat_sessions.json" />
        <!-- Agent workspaces hold user-imported snapshots, payloads and artifacts; they move only
             through the explicit Agent export format (architecture 10.2/10.6). -->
        <exclude domain="file" path="agent" />
        <!-- DSH official home/workspace/config/log tree; excluded from both cloud backup and
             device transfer, same reasoning as the app-local backup rules. -->
        <exclude domain="file" path="dsh" />
        <exclude domain="sharedpref" path="mca_api.xml" />
        <exclude domain="sharedpref" path="mca_cloud_api.xml" />
        <exclude domain="sharedpref" path="mca_web_search.xml" />
        <exclude domain="sharedpref" path="mca_web_search_diagnostics.xml" />
        <exclude domain="sharedpref" path="mca_local_api_idempotency_journal.xml" />
        <exclude domain="sharedpref" path="mca_local_image_models.xml" />
        <exclude domain="sharedpref" path="image_loras_v1.xml" />
        <exclude domain="sharedpref" path="image_upscalers_v1.xml" />
        <exclude domain="sharedpref" path="image_upscaler_product_selection_v1.xml" />
        <exclude domain="sharedpref" path="mca_image_generation_ui_parameters.xml" />
    </device-transfer>
</data-extraction-rules>
