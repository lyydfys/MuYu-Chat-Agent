<resources xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark counterpart of values/styles.xml, kept in step with the dark McaTheme scheme:
         status bar and navigation bar = background (#121212). Both stay equal to the runtime
         background to preserve the original launch seam and the StartupThemeContractTest
         contract; only the navigation-bar icon appearance is synced at the first frame. -->
    <style name="Theme.MuYuChatAgent" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#121212</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
