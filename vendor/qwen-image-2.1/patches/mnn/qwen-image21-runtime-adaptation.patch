+void reclaimRuntimeMemoryIfNeeded(const char* stage, int needMB) {
+    constexpr int kReserveMB = 400;
+    constexpr int kPollIntervalMs = 100;
+    constexpr int kMaxWaitMs = 5000;
+    constexpr int kStableSamplesRequired = 2;
+    const int beforeMB = QwenImage21Diffusion::availableMemoryMB();
+    const int requiredMB = needMB + kReserveMB;
+    if (beforeMB < 0 || beforeMB >= requiredMB) {
+        return;
+    }
+
+    // This runs on the serialized Qwen generation thread, after the text encoder has been destroyed.
+    // Reclaim only cached/free allocations; live prompt and diffusion tensors remain referenced.
+    auto executor = MNN::Express::Executor::getGlobalExecutor();
+    if (executor) {
+        executor->gc(MNN::Express::Executor::FULL);
+    }
+
+    int purgeApiLevel = 0;
+    int purgeOption = 0;
+    const int purgeResult = purgeUnusedHeapPages(false, purgeApiLevel, purgeOption);
+    const int afterGcMB = QwenImage21Diffusion::availableMemoryMB();
+    int purgeAllOption = 0;
+    int purgeAllResult = -1;
+    // Use the more expensive full purge only if a normal purge still leaves the DiT reserve short.
+    if (afterGcMB >= 0 && afterGcMB < requiredMB && purgeApiLevel >= 34) {
+        purgeAllResult = purgeUnusedHeapPages(true, purgeApiLevel, purgeAllOption);
+    }
+
+    const int afterPurgeMB = QwenImage21Diffusion::availableMemoryMB();
+    int settledMB = afterPurgeMB >= 0 ? afterPurgeMB : (afterGcMB >= 0 ? afterGcMB : beforeMB);
+    int waitedMs = 0;
+    int stableSamples = 0;
+    if (settledMB < requiredMB) {
+        // Releasing the CPU text encoder can return several gigabytes to Android asynchronously.
+        // Sample at a stage boundary so the existing reserve is enforced against settled memory,
+        // without starting the large DiT allocation while those pages are still being reclaimed.
+        for (int elapsedMs = 0; elapsedMs < kMaxWaitMs; elapsedMs += kPollIntervalMs) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(kPollIntervalMs));
+            waitedMs += kPollIntervalMs;
+            const int sampledMB = QwenImage21Diffusion::availableMemoryMB();
+            if (sampledMB < 0) {
+                continue;
+            }
+            settledMB = sampledMB;
+            stableSamples = settledMB >= requiredMB ? stableSamples + 1 : 0;
+            if (stableSamples >= kStableSamplesRequired) {
+                break;
+            }
+        }
+    }
+    MNN_PRINT(
+        "[QwenImage21] memory reclaim before %s: available %d MB, after_gc %d MB, after_purge %d MB, settled %d MB, "
+        "required %d MB, waited %d ms, mallopt api=%d option=%d result=%d full_option=%d full_result=%d\n",
+        stage, beforeMB, afterGcMB, afterPurgeMB, settledMB, requiredMB, waitedMs, purgeApiLevel, purgeOption,
+        purgeResult, purgeAllOption, purgeAllResult);
+}
