+            const float weight = weights[offset];
+            if (positionIndex < 0 || positionIndex >= positionEmbeddingCount) {
+                error = "interpolation_index_out_of_range_at_" + std::to_string(offset);
+                return false;
+            }
+            if (!std::isfinite(weight) || weight < 0.0f || weight > 1.0f) {
+                error = "interpolation_weight_out_of_range_at_" + std::to_string(offset);
+                return false;
+            }
+            stats.minimumIndex = positionIndex < stats.minimumIndex ? positionIndex : stats.minimumIndex;
+            stats.maximumIndex = positionIndex > stats.maximumIndex ? positionIndex : stats.maximumIndex;
+            stats.minimumWeight = weight < stats.minimumWeight ? weight : stats.minimumWeight;
+            stats.maximumWeight = weight > stats.maximumWeight ? weight : stats.maximumWeight;
+            weightSum += weight;
+        }
+        const float weightSumError = std::fabs(weightSum - 1.0f);
+        stats.maximumWeightSumError = weightSumError > stats.maximumWeightSumError
+                ? weightSumError
+                : stats.maximumWeightSumError;
+    }
+    if (stats.maximumWeightSumError > 1.0e-4f) {
+        error = "interpolation_weight_sum_mismatch";
+        return false;
+    }
+    return true;
+}
+
+inline bool buildConcatPlan(const std::vector<std::vector<int>>& shapes,
+                            int axis,
+                            int expectedHiddenSize,
+                            ConcatPlan& plan,
+                            std::string& error) {
+    plan = {};
+    error.clear();
+    if (shapes.empty()) {
+        error = "no_segments";
+        return false;
+    }
+    const size_t rank = shapes.front().size();
+    if (rank == 0) {
+        error = "rank_zero";
+        return false;
+    }
+    if (axis < 0) {
+        axis += static_cast<int>(rank);
+    }
+    if (axis < 0 || axis >= static_cast<int>(rank)) {
+        error = "axis_out_of_range";
+        return false;
+    }
+    plan.axis = axis;
+    plan.outputShape = shapes.front();
+    size_t outputAxis = 0;
+    for (size_t segmentIndex = 0; segmentIndex < shapes.size(); ++segmentIndex) {
+        const auto& shape = shapes[segmentIndex];
+        if (shape.size() != rank) {
+            error = "rank_mismatch_at_segment_" + std::to_string(segmentIndex);
+            return false;
+        }
+        if (expectedHiddenSize > 0 && shape.back() != expectedHiddenSize) {
+            error = "hidden_size_mismatch_at_segment_" + std::to_string(segmentIndex);
+            return false;
+        }
+        for (size_t dimension = 0; dimension < rank; ++dimension) {
+            if (shape[dimension] <= 0) {
+                error = "non_positive_dimension_at_segment_" + std::to_string(segmentIndex);
+                return false;
+            }
+            if (static_cast<int>(dimension) != axis && shape[dimension] != plan.outputShape[dimension]) {
+                error = "non_concat_dimension_mismatch_at_segment_" + std::to_string(segmentIndex);
+                return false;
+            }
+        }
+        const size_t axisLength = static_cast<size_t>(shape[axis]);
+        if (axisLength > std::numeric_limits<size_t>::max() - outputAxis) {
+            error = "concat_axis_overflow";
+            return false;
+        }
+        outputAxis += axisLength;
+        plan.axisLengths.push_back(axisLength);
+    }
+    if (outputAxis > static_cast<size_t>(std::numeric_limits<int>::max())) {
+        error = "concat_axis_exceeds_int";
+        return false;
+    }
+    plan.outputShape[axis] = static_cast<int>(outputAxis);
+
+    plan.outerCount = 1;
+    for (int dimension = 0; dimension < axis; ++dimension) {
+        if (!checkedMultiply(plan.outerCount, static_cast<size_t>(plan.outputShape[dimension]), plan.outerCount)) {
+            error = "outer_size_overflow";
+            return false;
+        }
+    }
+    plan.innerCount = 1;
+    for (size_t dimension = static_cast<size_t>(axis + 1); dimension < rank; ++dimension) {
+        if (!checkedMultiply(plan.innerCount, static_cast<size_t>(plan.outputShape[dimension]), plan.innerCount)) {
+            error = "inner_size_overflow";
+            return false;
+        }
+    }
+    size_t outerAndAxis = 0;
+    if (!checkedMultiply(plan.outerCount, outputAxis, outerAndAxis) ||
+        !checkedMultiply(outerAndAxis, plan.innerCount, plan.outputElements)) {
+        error = "output_size_overflow";
+        return false;
+    }
+    return true;
+}
+
+inline bool validateVisionPadRuns(const std::vector<int>& inputIds,
+                                  int visionPad,
+                                  const std::vector<int>& expectedLengths,
+                                  std::string& error) {
+    error.clear();
+    std::vector<int> actualLengths;
+    for (size_t index = 0; index < inputIds.size();) {
+        if (inputIds[index] != visionPad) {
+            ++index;
+            continue;
+        }
+        size_t end = index + 1;
+        while (end < inputIds.size() && inputIds[end] == visionPad) {
+            ++end;
+        }
+        actualLengths.push_back(static_cast<int>(end - index));
+        index = end;
+    }
+    if (actualLengths.size() != expectedLengths.size()) {
+        error = "vision_run_count_mismatch_expected_" + std::to_string(expectedLengths.size()) +
+                "_actual_" + std::to_string(actualLengths.size());
+        return false;
+    }
+    for (size_t index = 0; index < expectedLengths.size(); ++index) {
+        if (expectedLengths[index] <= 0 || actualLengths[index] != expectedLengths[index]) {
+            error = "vision_run_length_mismatch_at_" + std::to_string(index) +
+                    "_expected_" + std::to_string(expectedLengths[index]) +
+                    "_actual_" + std::to_string(actualLengths[index]);
+            return false;
+        }
+    }
+    return true;
+}
+
+inline size_t countPadRuns(const std::vector<int>& inputIds, int padToken) {
+    size_t runCount = 0;
+    for (size_t index = 0; index < inputIds.size();) {
+        if (inputIds[index] != padToken) {
+            ++index;
+            continue;
+        }
+        ++runCount;
+        do {
+            ++index;
+        } while (index < inputIds.size() && inputIds[index] == padToken);
+    }
+    return runCount;
+}
+
+inline bool chunkBoundarySplitsPadRun(const std::vector<int>& inputIds,
+                                      int padToken,
+                                      int chunkSize) {
+    if (chunkSize <= 0 || inputIds.size() <= static_cast<size_t>(chunkSize)) {
+        return false;
+    }
+    for (size_t boundary = static_cast<size_t>(chunkSize);
+         boundary < inputIds.size();
+         boundary += static_cast<size_t>(chunkSize)) {
+        if (inputIds[boundary - 1] == padToken && inputIds[boundary] == padToken) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Media embeddings are produced for a complete image/audio placeholder and are
+// not consumable a chunk at a time. Any request with pending media therefore
+// uses one atomic prefill. This preserves a one-to-one mapping between each
+// complete pad run and its materialized embedding even when the configured
+// language chunk size would otherwise split the run.
+inline bool buildMultimodalPrefillPlan(const std::vector<int>& inputIds,
+                                       int visionPad,
+                                       int audioPad,
+                                       size_t pendingVisionEmbeddings,
+                                       size_t pendingAudioEmbeddings,
+                                       int configuredChunkSize,
+                                       MultimodalPrefillPlan& plan,
+                                       std::string& error) {
+    plan = {};
+    error.clear();
+    plan.tokenCount = inputIds.size();
+    plan.effectiveChunkSize = configuredChunkSize;
+    if (pendingVisionEmbeddings == 0 && pendingAudioEmbeddings == 0) {
+        return true;
+    }
+    if (inputIds.empty()) {
+        error = "empty_multimodal_token_stream";
+        return false;
+    }
+    if (pendingVisionEmbeddings > 0) {
+        plan.visionRunCount = countPadRuns(inputIds, visionPad);
+        if (plan.visionRunCount != pendingVisionEmbeddings) {
+            error = "vision_run_count_mismatch_expected_" + std::to_string(pendingVisionEmbeddings) +
+                    "_actual_" + std::to_string(plan.visionRunCount);
+            return false;
+        }
+        plan.configuredChunkWouldSplitMediaRun =
+                chunkBoundarySplitsPadRun(inputIds, visionPad, configuredChunkSize);
+    }
+    if (pendingAudioEmbeddings > 0) {
+        plan.audioRunCount = countPadRuns(inputIds, audioPad);
+        if (plan.audioRunCount != pendingAudioEmbeddings) {
+            error = "audio_run_count_mismatch_expected_" + std::to_string(pendingAudioEmbeddings) +
+                    "_actual_" + std::to_string(plan.audioRunCount);
+            return false;
+        }
+        plan.configuredChunkWouldSplitMediaRun =
+                plan.configuredChunkWouldSplitMediaRun ||
+                chunkBoundarySplitsPadRun(inputIds, audioPad, configuredChunkSize);
+    }
+    plan.atomic = true;
+    plan.effectiveChunkSize = 0;
+    return true;
+}
+
+inline bool isQwen35VisionInputContract(const std::vector<std::string>& inputNames) {
+    static const std::vector<std::string> expected = {
+        "patches", "position_ids", "attention_mask", "idx_tensor", "weight_tensor"
+    };
+    return inputNames == expected;
+}
+
+} // namespace OmniEmbeddingContract
+} // namespace Transformer
+} // namespace MNN
+
+#endif
