+// Vision modules can own a different executor than the language model. Copying
+// their evaluated output into an INPUT variable while the LLM executor is
+// current prevents lazy expression graphs from crossing that boundary.
+static VARP materializeForLlmExecutor(VARP embedding) {
+    if (embedding == nullptr) {
+        return nullptr;
+    }
+    const auto info = embedding->getInfo();
+    if (info == nullptr || info->size <= 0 || info->type.bytes() <= 0) {
+        return nullptr;
+    }
+    size_t byteCount = 0;
+    if (!OmniEmbeddingContract::checkedMultiply(info->size, static_cast<size_t>(info->type.bytes()), byteCount)) {
+        return nullptr;
+    }
+    const auto source = embedding->readMap<uint8_t>();
+    if (source == nullptr) {
+        return nullptr;
+    }
+    auto copied = _Input(info->dim, info->order, info->type);
+    if (copied == nullptr) {
+        return nullptr;
+    }
+    auto destination = copied->writeMap<uint8_t>();
+    if (destination == nullptr) {
+        return nullptr;
+    }
+    ::memcpy(destination, source, byteCount);
+    return copied;
+}
+
+static bool sameTensorType(const halide_type_t& lhs, const halide_type_t& rhs) {
+    return lhs.code == rhs.code && lhs.bits == rhs.bits && lhs.lanes == rhs.lanes;
+}
+
+// Embedding segments may originate from different runtime managers. Building a
+// lazy _Concat expression links those graphs and can dereference an expired
+// Expr input. Concatenate already-materialized host buffers instead so the LLM
+// receives one self-contained INPUT variable.
+static VARP concatMaterializedEmbeddings(const std::vector<VARP>& segments,
+                                         int axis,
+                                         int expectedHiddenSize,
+                                         const char* diagnosticLabel) {
+    std::vector<std::vector<int>> shapes;
+    std::vector<const Variable::Info*> infos;
+    shapes.reserve(segments.size());
+    infos.reserve(segments.size());
+    for (size_t index = 0; index < segments.size(); ++index) {
+        if (segments[index] == nullptr) {
+            MNN_PRINT("Omni embedding contract failed label=%s reason=null_segment index=%zu\n", diagnosticLabel, index);
+            return nullptr;
+        }
+        const auto info = segments[index]->getInfo();
+        if (info == nullptr || info->size == 0 || info->type.bytes() <= 0) {
+            MNN_PRINT("Omni embedding contract failed label=%s reason=invalid_info index=%zu\n", diagnosticLabel, index);
+            return nullptr;
+        }
+        if (!infos.empty() &&
+            (info->order != infos.front()->order || !sameTensorType(info->type, infos.front()->type))) {
+            MNN_PRINT("Omni embedding contract failed label=%s reason=type_or_order_mismatch index=%zu\n",
+                      diagnosticLabel, index);
+            return nullptr;
+        }
+        infos.push_back(info);
+        shapes.push_back(info->dim);
+    }
+
+    OmniEmbeddingContract::ConcatPlan plan;
+    std::string error;
+    if (!OmniEmbeddingContract::buildConcatPlan(shapes, axis, expectedHiddenSize, plan, error)) {
+        MNN_PRINT("Omni embedding contract failed label=%s reason=%s\n", diagnosticLabel, error.c_str());
+        return nullptr;
+    }
+    const size_t elementBytes = static_cast<size_t>(infos.front()->type.bytes());
+    size_t outputBytes = 0;
+    if (!OmniEmbeddingContract::checkedMultiply(plan.outputElements, elementBytes, outputBytes)) {
+        MNN_PRINT("Omni embedding contract failed label=%s reason=output_byte_overflow\n", diagnosticLabel);
+        return nullptr;
+    }
+
+    std::vector<const uint8_t*> sources;
+    sources.reserve(segments.size());
+    for (size_t index = 0; index < segments.size(); ++index) {
+        size_t expectedElements = 0;
+        size_t outerAndAxis = 0;
+        if (!OmniEmbeddingContract::checkedMultiply(plan.outerCount, plan.axisLengths[index], outerAndAxis) ||
+            !OmniEmbeddingContract::checkedMultiply(outerAndAxis, plan.innerCount, expectedElements) ||
+            expectedElements != infos[index]->size) {
+            MNN_PRINT("Omni embedding contract failed label=%s reason=logical_size_mismatch index=%zu expected=%zu actual=%zu\n",
+                      diagnosticLabel, index, expectedElements, infos[index]->size);
+            return nullptr;
+        }
+        const auto source = segments[index]->readMap<uint8_t>();
+        if (source == nullptr) {
+            MNN_PRINT("Omni embedding contract failed label=%s reason=read_map_failed index=%zu\n", diagnosticLabel, index);
+            return nullptr;
+        }
+        sources.push_back(source);
+    }
+
+    auto output = _Input(plan.outputShape, infos.front()->order, infos.front()->type);
+    if (output == nullptr) {
+        MNN_PRINT("Omni embedding contract failed label=%s reason=output_alloc_failed\n", diagnosticLabel);
+        return nullptr;
+    }
+    auto destination = output->writeMap<uint8_t>();
+    if (destination == nullptr) {
+        MNN_PRINT("Omni embedding contract failed label=%s reason=write_map_failed\n", diagnosticLabel);
+        return nullptr;
+    }
+    size_t outputAxis = static_cast<size_t>(plan.outputShape[plan.axis]);
+    for (size_t outer = 0; outer < plan.outerCount; ++outer) {
+        size_t axisOffset = 0;
+        for (size_t index = 0; index < segments.size(); ++index) {
+            size_t chunkElements = 0;
+            if (!OmniEmbeddingContract::checkedMultiply(plan.axisLengths[index], plan.innerCount, chunkElements)) {
+                return nullptr;
+            }
+            const size_t sourceElementOffset = outer * chunkElements;
+            const size_t destinationElementOffset = (outer * outputAxis + axisOffset) * plan.innerCount;
+            ::memcpy(destination + destinationElementOffset * elementBytes,
+                     sources[index] + sourceElementOffset * elementBytes,
+                     chunkElements * elementBytes);
+            axisOffset += plan.axisLengths[index];
+        }
+    }
+    MNN_ASSERT(output->getInfo() != nullptr && output->getInfo()->size == plan.outputElements);
+    (void)outputBytes;
+    return output;
+}
