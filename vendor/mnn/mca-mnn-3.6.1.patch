+//
+//  SplitGeLUFusedTest.cpp
+//  MNNTests
+//
+
+#ifdef MNN_SUPPORT_TRANSFORMER_FUSE
+
+#include <MNN/expr/Expr.hpp>
+#include <MNN/expr/ExprCreator.hpp>
+
+#include <cmath>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+#include "MNNTestSuite.h"
+#include "TestUtils.h"
+
+using namespace MNN;
+using namespace MNN::Express;
+
+namespace {
+
+static std::vector<float> splitGeLUReference(const std::vector<float>& input, const std::vector<float>& bias, int rows,
+                                             int dim) {
+    std::vector<float> output(rows * dim);
+    for (int row = 0; row < rows; ++row) {
+        for (int i = 0; i < dim; ++i) {
+            float left = input[row * dim * 2 + i];
+            float right = input[row * dim * 2 + dim + i];
+            if (!bias.empty()) {
+                left += bias[i];
+                right += bias[dim + i];
+            }
+            const float gelu = 0.5f * right * (1.0f + std::erf(right / std::sqrt(2.0f)));
+            output[row * dim + i] = left * gelu;
+        }
+    }
+    return output;
+}
+
+static bool runSplitGeLUCase(int batch, int seqLen, int dim, bool withBias) {
+    const int rows = batch * seqLen;
+    std::vector<float> inputData(rows * dim * 2);
+    std::vector<float> biasData(withBias ? dim * 2 : 0);
+    for (int i = 0; i < static_cast<int>(inputData.size()); ++i) {
+        inputData[i] = static_cast<float>((i * 19 + 7) % 43 - 21) * 0.053f;
+    }
+    for (int i = 0; i < static_cast<int>(biasData.size()); ++i) {
+        biasData[i] = static_cast<float>((i * 5 + 2) % 13 - 6) * 0.017f;
+    }
+
+    auto input = _Input({batch, seqLen, dim * 2}, NCHW, halide_type_of<float>());
+    ::memcpy(input->writeMap<float>(), inputData.data(), inputData.size() * sizeof(float));
+    input->unMap();
+    std::vector<VARP> inputs = {input};
+    if (withBias) {
+        inputs.emplace_back(_Const(biasData.data(), {dim * 2}, NCHW, halide_type_of<float>()));
+    }
+
+    std::unique_ptr<OpT> op(new OpT);
+    op->type = OpType_SplitGeLU;
+    op->defaultDimentionFormat = MNN_DATA_FORMAT_NCHW;
+    auto output = Variable::create(Expr::create(std::move(op), inputs));
+    const float* outputPtr = output->readMap<float>();
+    if (outputPtr == nullptr) {
+        MNN_ERROR("SplitGeLUFusedTest failed to execute B=%d S=%d D=%d bias=%d\n", batch, seqLen, dim,
+                  withBias ? 1 : 0);
+        return false;
+    }
+    const auto expected = splitGeLUReference(inputData, biasData, rows, dim);
+    if (!checkVector<float>(outputPtr, expected.data(), expected.size(), 0.0005f)) {
+        MNN_ERROR("SplitGeLUFusedTest mismatch B=%d S=%d D=%d bias=%d\n", batch, seqLen, dim, withBias ? 1 : 0);
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+class SplitGeLUFusedTest : public MNNTestCase {
+public:
+    virtual ~SplitGeLUFusedTest() = default;
+
+    virtual bool run(int precision) override {
+        return runSplitGeLUCase(2, 3, 5, false) && runSplitGeLUCase(1, 4, 7, true);
+    }
+};
+
+MNNTestSuiteRegister(SplitGeLUFusedTest, "op/splitgelu_fused");
+
+#endif // MNN_SUPPORT_TRANSFORMER_FUSE
