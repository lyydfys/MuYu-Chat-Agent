diff --git a/source/backend/cpu/CPUSplitGeLU.cpp b/source/backend/cpu/CPUSplitGeLU.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..deae9fb3dd14ff7446d8a15b23b165e6a3e52ed1
--- /dev/null
+++ b/source/backend/cpu/CPUSplitGeLU.cpp
@@ -0,0 +1,125 @@
+//
+//  CPUSplitGeLU.cpp
+//  MNN
+//
+//  Created by MNN on 2026/09/01.
+//  Copyright © 2018, Alibaba Group Holding Limited
+//
+
+#ifdef MNN_SUPPORT_TRANSFORMER_FUSE
+
+#include "CPUSplitGeLU.hpp"
+#include "backend/cpu/CPUBackend.hpp"
+#include "backend/cpu/compute/CommonOptFunction.h"
+#include "core/Concurrency.h"
+#include "core/TensorUtils.hpp"
+#include "MNN_generated.h"
+#include <cmath>
+#include <cstdint>
+#include <limits>
+
+namespace MNN {
+
+namespace {
+constexpr float kSplitGeluInvSqrt2 = 0.7071067932881648f;
+
+inline float splitGeluActivation(float x) {
+    return 0.5f * x * (1.0f + std::erf(x * kSplitGeluInvSqrt2));
+}
+} // namespace
+
+CPUSplitGeLU::CPUSplitGeLU(Backend* backend, const MNN::Op* op) : Execution(backend) {}
+
+ErrorCode CPUSplitGeLU::onResize(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs) {
+    if ((inputs.size() != 1 && inputs.size() != 2) || outputs.size() != 1 || inputs[0] == nullptr ||
+        outputs[0] == nullptr) {
+        return INPUT_DATA_ERROR;
+    }
+    auto input = inputs[0];
+    if (input->dimensions() != 3 || outputs[0]->dimensions() != 3) {
+        return INPUT_DATA_ERROR;
+    }
+    const auto inputFormat = TensorUtils::getDescribe(input)->dimensionFormat;
+    const auto outputFormat = TensorUtils::getDescribe(outputs[0])->dimensionFormat;
+    if ((inputFormat != MNN_DATA_FORMAT_NCHW && inputFormat != MNN_DATA_FORMAT_NHWC) || outputFormat != inputFormat) {
+        return NOT_SUPPORT;
+    }
+    if (input->length(0) <= 0 || input->length(1) <= 0 || input->length(2) <= 0 || input->length(2) % 2 != 0) {
+        return INPUT_DATA_ERROR;
+    }
+    const int64_t rows = static_cast<int64_t>(input->length(0)) * input->length(1);
+    if (rows > std::numeric_limits<int>::max()) {
+        return INPUT_DATA_ERROR;
+    }
+    mRows = static_cast<int>(rows);
+    mDim = input->length(2) / 2;
+    if (outputs[0]->length(0) != input->length(0) || outputs[0]->length(1) != input->length(1) ||
+        outputs[0]->length(2) != mDim || outputs[0]->getType() != input->getType()) {
+        return INPUT_DATA_ERROR;
+    }
+    if (inputs.size() == 2 && (inputs[1] == nullptr || inputs[1]->dimensions() != 1 ||
+                               inputs[1]->length(0) != input->length(2) || inputs[1]->getType() != input->getType())) {
+        return INPUT_DATA_ERROR;
+    }
+    auto bn = static_cast<CPUBackend*>(backend());
+    if (bn->functions()->bytes != static_cast<int>(sizeof(float))) {
+        return NOT_SUPPORT;
+    }
+    return NO_ERROR;
+}
+
+ErrorCode CPUSplitGeLU::onExecute(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs) {
+    auto input = inputs[0];
+    auto output = outputs[0];
+    const bool isFloat = (input->getType().code == halide_type_float && input->getType().bits == 32);
+    auto bn = static_cast<CPUBackend*>(backend());
+    if (!isFloat || bn->functions()->bytes != static_cast<int>(sizeof(float)) || input->host<float>() == nullptr ||
+        output->host<float>() == nullptr) {
+        return NOT_SUPPORT;
+    }
+    const bool hasBias = (inputs.size() > 1);
+    const int rows = mRows;
+    const int dim = mDim;
+    const float* inPtr = input->host<float>();
+    const float* biasPtr = hasBias ? inputs[1]->host<float>() : nullptr;
+    float* outPtr = output->host<float>();
+    if (hasBias && biasPtr == nullptr) {
+        return INPUT_DATA_ERROR;
+    }
+    const int threadNumber = ALIMIN(bn->threadNumber(), rows);
+    if (threadNumber < 1) {
+        return NOT_SUPPORT;
+    }
+    const int rowSpan = 2 * dim;
+    MNN_CONCURRENCY_BEGIN(tId, threadNumber) {
+        for (int row = tId; row < rows; row += threadNumber) {
+            const float* inRow = inPtr + row * rowSpan;
+            float* outRow = outPtr + row * dim;
+            for (int i = 0; i < dim; ++i) {
+                float valueL = inRow[i];
+                float valueR = inRow[i + dim];
+                if (biasPtr != nullptr) {
+                    valueL += biasPtr[i];
+                    valueR += biasPtr[i + dim];
+                }
+                outRow[i] = splitGeluActivation(valueR) * valueL;
+            }
+        }
+    }
+    MNN_CONCURRENCY_END();
+    return NO_ERROR;
+}
+
+class CPUSplitGeLUCreator : public CPUBackend::Creator {
+public:
+    virtual Execution* onCreate(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs,
+                                const MNN::Op* op, Backend* backend) const override {
+        return new CPUSplitGeLU(backend, op);
+    }
+};
+
+REGISTER_CPU_OP_CREATOR_TRANSFORMER(CPUSplitGeLUCreator, OpType_SplitGeLU);
+
+} // namespace MNN
+
+#endif /* MNN_SUPPORT_TRANSFORMER_FUSE */
