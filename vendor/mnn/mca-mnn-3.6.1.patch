+#include <MNN/expr/ExprCreator.hpp>
+
+#include "MNNTestSuite.h"
+#include "TestUtils.h"
+
+using namespace MNN;
+using namespace MNN::Express;
+
+namespace {
+
+struct GroupNormCase {
+    int batch;
+    int channel;
+    int height;
+    int width;
+    int group;
+    bool withBias;
+    bool withAffine;
+    bool swish;
+    Dimensionformat format;
+    const char* name;
+};
+
+static std::vector<float> groupNormReference(const std::vector<float>& input, const std::vector<float>& bias,
+                                             const std::vector<float>& gamma, const std::vector<float>& beta,
+                                             const GroupNormCase& config, float epsilon) {
+    const int area = config.height * config.width;
+    const int channelsPerGroup = config.channel / config.group;
+    const int elementsPerGroup = channelsPerGroup * area;
+    std::vector<float> output(input.size());
+    for (int n = 0; n < config.batch; ++n) {
+        for (int g = 0; g < config.group; ++g) {
+            const int channelBegin = g * channelsPerGroup;
+            double sum = 0.0;
+            for (int c = channelBegin; c < channelBegin + channelsPerGroup; ++c) {
+                const float channelBias = config.withBias ? bias[n * config.channel + c] : 0.0f;
+                for (int x = 0; x < area; ++x) {
+                    sum += input[(n * config.channel + c) * area + x] + channelBias;
+                }
+            }
+            const float mean = static_cast<float>(sum / elementsPerGroup);
+            double squareSum = 0.0;
+            for (int c = channelBegin; c < channelBegin + channelsPerGroup; ++c) {
+                const float channelBias = config.withBias ? bias[n * config.channel + c] : 0.0f;
+                for (int x = 0; x < area; ++x) {
+                    const float value = input[(n * config.channel + c) * area + x] + channelBias;
+                    const float delta = value - mean;
+                    squareSum += static_cast<double>(delta) * delta;
+                }
+            }
+            const float invStd = 1.0f / std::sqrt(static_cast<float>(squareSum / elementsPerGroup) + epsilon);
+            for (int c = channelBegin; c < channelBegin + channelsPerGroup; ++c) {
+                const float channelBias = config.withBias ? bias[n * config.channel + c] : 0.0f;
+                for (int x = 0; x < area; ++x) {
+                    const int index = (n * config.channel + c) * area + x;
+                    float value = (input[index] + channelBias - mean) * invStd;
+                    if (config.withAffine) {
+                        value = value * gamma[c] + beta[c];
+                    }
+                    if (config.swish) {
+                        value = value / (1.0f + std::exp(-value));
+                    }
+                    output[index] = value;
+                }
+            }
+        }
+    }
+    return output;
+}
+
+static bool runGroupNormCase(const GroupNormCase& config, int precision) {
+    const float epsilon = 1.0e-5f;
+    const int area = config.height * config.width;
+    const int elementCount = config.batch * config.channel * area;
+    std::vector<float> inputData(elementCount);
+    std::vector<float> bias(config.batch * config.channel);
+    std::vector<float> gamma(config.channel);
+    std::vector<float> beta(config.channel);
+    for (int i = 0; i < elementCount; ++i) {
+        inputData[i] = static_cast<float>((i * 17 + 5) % 41 - 20) * 0.071f + static_cast<float>(i % 7) * 0.013f;
+    }
+    for (int n = 0; n < config.batch; ++n) {
+        for (int c = 0; c < config.channel; ++c) {
+            bias[n * config.channel + c] = static_cast<float>((n + 1) * (c + 3) % 9 - 4) * 0.037f;
+        }
+    }
+    for (int c = 0; c < config.channel; ++c) {
+        gamma[c] = 0.61f + static_cast<float>((c * 3) % 7) * 0.083f;
+        beta[c] = static_cast<float>((c * 5) % 11 - 5) * 0.029f;
+    }
+
+    auto input = _Input({config.batch, config.channel, config.height, config.width}, NCHW, halide_type_of<float>());
+    ::memcpy(input->writeMap<float>(), inputData.data(), inputData.size() * sizeof(float));
+    input->unMap();
+    if (config.format == NC4HW4) {
+        input = _Convert(input, NC4HW4);
+    }
+
+    std::vector<VARP> inputs = {input};
+    if (config.withBias) {
+        auto biasInput = _Input({config.batch, config.channel}, NCHW, halide_type_of<float>());
+        ::memcpy(biasInput->writeMap<float>(), bias.data(), bias.size() * sizeof(float));
+        biasInput->unMap();
+        inputs.emplace_back(biasInput);
+    }
+
+    std::unique_ptr<OpT> op(new OpT);
+    op->type = OpType_GroupNorm;
+    op->main.type = OpParameter_GroupNorm;
+    op->main.value = new GroupNormT;
+    op->defaultDimentionFormat = config.format == NC4HW4 ? MNN_DATA_FORMAT_NC4HW4 : MNN_DATA_FORMAT_NCHW;
+    auto param = op->main.AsGroupNorm();
+    param->axis = 1;
+    param->epsilon = epsilon;
+    param->group = config.group;
+    param->bSwish = config.swish ? 1 : 0;
+    if (config.withAffine) {
+        param->gamma = gamma;
+        param->beta = beta;
+    }
+
+    auto output = Variable::create(Expr::create(std::move(op), inputs));
+    if (config.format == NC4HW4) {
+        output = _Convert(output, NCHW);
+    }
+    const auto expected = groupNormReference(inputData, bias, gamma, beta, config, epsilon);
+    const float tolerance = precision <= BackendConfig::Precision_High ? 2.0e-4f : 2.0e-2f;
+    const float* outputPtr = output->readMap<float>();
+    if (outputPtr == nullptr || !checkVector<float>(outputPtr, expected.data(), expected.size(), tolerance)) {
+        MNN_ERROR("GroupNormFusedTest %s failed\n", config.name);
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+class GroupNormFusedTest : public MNNTestCase {
+public:
+    virtual ~GroupNormFusedTest() = default;
+
+    virtual bool run(int precision) override {
+        const GroupNormCase cases[] = {
+            {2, 8, 2, 3, 4, true, true, true, NCHW, "nchw_bias_affine_swish"},
+            {2, 8, 2, 3, 4, true, true, true, NC4HW4, "nc4hw4_bias_affine_swish"},
+            {2, 6, 3, 2, 3, false, false, false, NC4HW4, "nc4hw4_channel_tail"},
+        };
+        for (const auto& config : cases) {
+            if (!runGroupNormCase(config, precision)) {
+                return false;
+            }
+        }
+        return true;
+    }
+};
+
+MNNTestSuiteRegister(GroupNormFusedTest, "op/groupnorm_fused");
+
+#endif // MNN_SUPPORT_TRANSFORMER_FUSE
