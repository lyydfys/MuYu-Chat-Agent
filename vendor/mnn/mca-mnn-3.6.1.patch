+//
+//  CPUFmhaV2.hpp
+//  MNN
+//
+//  Created by MNN on 2026/09/01.
+//  Copyright © 2018, Alibaba Group Holding Limited
+//
+
+#ifndef CPUFmhaV2_hpp
+#define CPUFmhaV2_hpp
+
+#include "core/Execution.hpp"
+
+namespace MNN {
+class CPUFmhaV2 : public Execution {
+public:
+    CPUFmhaV2(Backend* backend, const MNN::Op* op);
+    virtual ~CPUFmhaV2() = default;
+
+    virtual ErrorCode onResize(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs) override;
+    virtual ErrorCode onExecute(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs) override;
+
+private:
+    int mNumHead = 0;
+    int mHeadDim = 1;
+    int mSeqLen = 1;
+    int mBatch = 1;
+    int mInputWidth = 0;
+    int mOutputWidth = 0;
+    bool mSequencePacked = false;
+    float mScale = 1.0f;
+    std::vector<float> mScore;
+};
+
+} // namespace MNN
+
+#endif /* CPUFmhaV2_hpp */
diff --git a/source/backend/cpu/CPUGroupNorm.cpp b/source/backend/cpu/CPUGroupNorm.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..52b308b257cd8ddff75a24922d476db5c1d02a48
--- /dev/null
+++ b/source/backend/cpu/CPUGroupNorm.cpp
@@ -0,0 +1,227 @@
+//
+//  CPUGroupNorm.cpp
+//  MNN
+//
+//  Created by MNN on 2026/09/01.
+//  Copyright © 2018, Alibaba Group Holding Limited
+//
+
+#ifdef MNN_SUPPORT_TRANSFORMER_FUSE
+
+#include "CPUGroupNorm.hpp"
+#include "backend/cpu/CPUBackend.hpp"
+#include "backend/cpu/CPUTensorConvert.hpp"
+#include "backend/cpu/compute/CommonOptFunction.h"
+#include "core/Concurrency.h"
+#include "core/TensorUtils.hpp"
+#include "MNN_generated.h"
+#include <cmath>
+#include <cstdint>
+#include <limits>
+
+namespace MNN {
+
+namespace {
+
+void groupNormGroup(const float* input, const float* bias, float* output, int elementCount, int spatial, float epsilon,
+                    bool swish, const float* gamma, const float* beta) {
+    float sum = 0.0f;
+    for (int i = 0; i < elementCount; ++i) {
+        const float value = input[i] + (bias != nullptr ? bias[i / spatial] : 0.0f);
+        sum += value;
+    }
+    const float mean = sum / static_cast<float>(elementCount);
+    float squareSum = 0.0f;
+    for (int i = 0; i < elementCount; ++i) {
+        const float value = input[i] + (bias != nullptr ? bias[i / spatial] : 0.0f);
+        const float delta = value - mean;
+        squareSum += delta * delta;
+    }
+    const float inverseStd = 1.0f / std::sqrt(squareSum / static_cast<float>(elementCount) + epsilon);
+    for (int i = 0; i < elementCount; ++i) {
+        const int channel = i / spatial;
+        const float value = input[i] + (bias != nullptr ? bias[channel] : 0.0f);
+        float normalized = (value - mean) * inverseStd;
+        if (gamma != nullptr && beta != nullptr) {
+            normalized = normalized * gamma[channel] + beta[channel];
+        }
+        if (swish) {
+            normalized = normalized / (1.0f + std::exp(-normalized));
+        }
+        output[i] = normalized;
+    }
+}
+
+} // namespace
+
+CPUGroupNorm::CPUGroupNorm(Backend* backend, const MNN::Op* op) : Execution(backend) {
+    auto param = op->main_as_GroupNorm();
+    if (param == nullptr) {
+        return;
+    }
+    mEpsilon = param->epsilon();
+    mGroup = param->group();
+    mBSwish = param->bSwish() != 0;
+    mHasExternalWeights = param->external() != nullptr && param->external()->size() > 0;
+    const bool hasGamma = param->gamma() != nullptr && param->gamma()->size() > 0;
+    const bool hasBeta = param->beta() != nullptr && param->beta()->size() > 0;
+    if (hasGamma != hasBeta || (hasGamma && param->gamma()->size() != param->beta()->size())) {
+        return;
+    }
+    if (hasGamma) {
+        mHasAffine = true;
+        mGamma.resize(param->gamma()->size());
+        mBeta.resize(param->beta()->size());
+        for (size_t i = 0; i < mGamma.size(); ++i) {
+            mGamma[i] = param->gamma()->Get(i);
+            mBeta[i] = param->beta()->Get(i);
+        }
+    }
+    mParameterValid = mGroup > 0 && std::isfinite(mEpsilon) && mEpsilon >= 0.0f && !mHasExternalWeights;
+}
+
+ErrorCode CPUGroupNorm::onResize(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs) {
+    if (!mParameterValid || (inputs.size() != 1 && inputs.size() != 2) || outputs.size() != 1 || inputs[0] == nullptr ||
+        outputs[0] == nullptr) {
+        return INPUT_DATA_ERROR;
+    }
+    auto input = inputs[0];
+    auto output = outputs[0];
+    auto bn = static_cast<CPUBackend*>(backend());
+    auto core = bn->functions();
+    if (core == nullptr || core->bytes != static_cast<int>(sizeof(float)) || input->dimensions() < 2 ||
+        output->dimensions() != input->dimensions() || input->getType().code != halide_type_float ||
+        input->getType().bits != 32 || output->getType() != input->getType()) {
+        return NOT_SUPPORT;
+    }
+    const auto layout = TensorUtils::getDescribe(input)->dimensionFormat;
+    if ((layout != MNN_DATA_FORMAT_NCHW && layout != MNN_DATA_FORMAT_NC4HW4) ||
+        TensorUtils::getDescribe(output)->dimensionFormat != layout) {
+        return NOT_SUPPORT;
+    }
+    for (int i = 0; i < input->dimensions(); ++i) {
+        if (input->length(i) <= 0 || output->length(i) != input->length(i)) {
+            return INPUT_DATA_ERROR;
+        }
+    }
+
+    mNeedUnpackC4 = layout == MNN_DATA_FORMAT_NC4HW4;
+    mChannel = input->length(1);
+    if (mGroup > mChannel || mChannel % mGroup != 0 ||
+        (mHasAffine &&
+         (mGamma.size() != static_cast<size_t>(mChannel) || mBeta.size() != static_cast<size_t>(mChannel)))) {
+        return INPUT_DATA_ERROR;
+    }
+
+    int64_t spatial = 1;
+    for (int i = 2; i < input->dimensions(); ++i) {
+        spatial *= input->length(i);
+        if (spatial > std::numeric_limits<int>::max()) {
+            return INPUT_DATA_ERROR;
+        }
+    }
+    mSpatial = static_cast<int>(spatial);
+    const int64_t outerSize = static_cast<int64_t>(input->length(0)) * mGroup;
+    const int64_t innerSize = static_cast<int64_t>(mChannel / mGroup) * mSpatial;
+    const int64_t elementCount = static_cast<int64_t>(input->length(0)) * mChannel * mSpatial;
+    if (outerSize > std::numeric_limits<int>::max() || innerSize > std::numeric_limits<int>::max() ||
+        elementCount > std::numeric_limits<int>::max()) {
+        return INPUT_DATA_ERROR;
+    }
+    mOutterSize = static_cast<int>(outerSize);
+    mInnerSize = static_cast<int>(innerSize);
+
+    if (inputs.size() == 2) {
+        auto bias = inputs[1];
+        if (bias == nullptr || bias->dimensions() != 2 || bias->length(0) != input->length(0) ||
+            bias->length(1) != mChannel || bias->getType() != input->getType()) {
+            return INPUT_DATA_ERROR;
+        }
+    }
+
+    if (mNeedUnpackC4) {
+        auto allocator = bn->getBufferAllocator();
+        const size_t scratchBytes = static_cast<size_t>(elementCount) * sizeof(float);
+        mUnpackedInput = allocator->alloc(scratchBytes);
+        mUnpackedOutput = allocator->alloc(scratchBytes);
+        if (mUnpackedInput.invalid() || mUnpackedOutput.invalid()) {
+            if (!mUnpackedInput.invalid()) {
+                allocator->free(mUnpackedInput);
+            }
+            if (!mUnpackedOutput.invalid()) {
+                allocator->free(mUnpackedOutput);
+            }
+            return OUT_OF_MEMORY;
+        }
+        allocator->free(mUnpackedInput);
+        allocator->free(mUnpackedOutput);
+    }
+    return NO_ERROR;
+}
+
+ErrorCode CPUGroupNorm::onExecute(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs) {
+    auto input = inputs[0];
+    auto output = outputs[0];
+    const bool hasBias = inputs.size() == 2;
+    auto bn = static_cast<CPUBackend*>(backend());
+    auto core = bn->functions();
+    if (core == nullptr || core->bytes != static_cast<int>(sizeof(float)) || input->host<float>() == nullptr ||
+        output->host<float>() == nullptr || (hasBias && inputs[1]->host<float>() == nullptr)) {
+        return NOT_SUPPORT;
+    }
+    const int threadNumber = ALIMIN(bn->threadNumber(), mOutterSize);
+    if (threadNumber < 1) {
+        return NOT_SUPPORT;
+    }
+
+    const float* inputPtr = input->host<float>();
+    float* outputPtr = output->host<float>();
+    if (mNeedUnpackC4) {
+        auto code =
+            CPUTensorConverter::convert(inputPtr, mUnpackedInput.ptr(), MNN_DATA_FORMAT_NC4HW4, MNN_DATA_FORMAT_NCHW,
+                                        input->length(0), mSpatial, mChannel, sizeof(float), core);
+        if (code != NO_ERROR) {
+            return code;
+        }
+        inputPtr = reinterpret_cast<const float*>(mUnpackedInput.ptr());
+        outputPtr = reinterpret_cast<float*>(mUnpackedOutput.ptr());
+    }
+
+    const int channelsPerGroup = mChannel / mGroup;
+    const float* gamma = mHasAffine ? mGamma.data() : nullptr;
+    const float* beta = mHasAffine ? mBeta.data() : nullptr;
+    const float* bias = hasBias ? inputs[1]->host<float>() : nullptr;
+    MNN_CONCURRENCY_BEGIN(tId, threadNumber) {
+        for (int outer = tId; outer < mOutterSize; outer += threadNumber) {
+            const int batch = outer / mGroup;
+            const int group = outer % mGroup;
+            const int channelBegin = group * channelsPerGroup;
+            const float* biasGroup = bias != nullptr ? bias + batch * mChannel + channelBegin : nullptr;
+            groupNormGroup(inputPtr + outer * mInnerSize, biasGroup, outputPtr + outer * mInnerSize, mInnerSize,
+                           mSpatial, mEpsilon, mBSwish, gamma != nullptr ? gamma + channelBegin : nullptr,
+                           beta != nullptr ? beta + channelBegin : nullptr);
+        }
+    }
+    MNN_CONCURRENCY_END();
+
+    if (mNeedUnpackC4) {
+        return CPUTensorConverter::convert(outputPtr, output->host<float>(), MNN_DATA_FORMAT_NCHW,
+                                           MNN_DATA_FORMAT_NC4HW4, input->length(0), mSpatial, mChannel, sizeof(float),
+                                           core);
+    }
+    return NO_ERROR;
+}
+
+class CPUGroupNormCreator : public CPUBackend::Creator {
+public:
+    virtual Execution* onCreate(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs,
+                                const MNN::Op* op, Backend* backend) const override {
+        return new CPUGroupNorm(backend, op);
+    }
+};
+
+REGISTER_CPU_OP_CREATOR_TRANSFORMER(CPUGroupNormCreator, OpType_GroupNorm);
+
+} // namespace MNN
+
+#endif /* MNN_SUPPORT_TRANSFORMER_FUSE */
