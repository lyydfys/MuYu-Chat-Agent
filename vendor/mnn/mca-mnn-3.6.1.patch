diff --git a/test/op/FmhaV2Test.cpp b/test/op/FmhaV2Test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e8e554dfe706482693018c946307cde11d94e329
--- /dev/null
+++ b/test/op/FmhaV2Test.cpp
@@ -0,0 +1,123 @@
+//
+//  FmhaV2Test.cpp
+//  MNNTests
+//
+
+#ifdef MNN_SUPPORT_TRANSFORMER_FUSE
+
+#include <MNN/expr/Expr.hpp>
+#include <MNN/expr/ExprCreator.hpp>
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <vector>
+
+#include "MNNTestSuite.h"
+#include "TestUtils.h"
+
+using namespace MNN;
+using namespace MNN::Express;
+
+namespace {
+
+std::vector<float> referenceFmhaV2(const std::vector<float>& input, int batch, int seqLen, int numHead, int headDim) {
+    const int qkvWidth = numHead * 3 * headDim;
+    const int outputWidth = numHead * headDim;
+    const float scale = 1.0f / std::sqrt(static_cast<float>(headDim));
+    std::vector<float> output(batch * seqLen * outputWidth, 0.0f);
+    std::vector<float> scores(seqLen);
+
+    for (int b = 0; b < batch; ++b) {
+        for (int h = 0; h < numHead; ++h) {
+            for (int q = 0; q < seqLen; ++q) {
+                float maxScore = -std::numeric_limits<float>::infinity();
+                for (int k = 0; k < seqLen; ++k) {
+                    float dot = 0.0f;
+                    for (int d = 0; d < headDim; ++d) {
+                        const int qIndex = (b * seqLen + q) * qkvWidth + h * 3 * headDim + d;
+                        const int kIndex = (b * seqLen + k) * qkvWidth + h * 3 * headDim + headDim + d;
+                        dot += input[qIndex] * input[kIndex];
+                    }
+                    scores[k] = dot * scale;
+                    maxScore = std::max(maxScore, scores[k]);
+                }
+                float sum = 0.0f;
+                for (int k = 0; k < seqLen; ++k) {
+                    scores[k] = std::exp(scores[k] - maxScore);
+                    sum += scores[k];
+                }
+                for (int d = 0; d < headDim; ++d) {
+                    float value = 0.0f;
+                    for (int k = 0; k < seqLen; ++k) {
+                        const int vIndex = (b * seqLen + k) * qkvWidth + h * 3 * headDim + 2 * headDim + d;
+                        value += scores[k] * input[vIndex];
+                    }
+                    output[(b * seqLen + q) * outputWidth + h * headDim + d] = value / sum;
+                }
+            }
+        }
+    }
+    return output;
+}
+
+VARP createFmhaV2(VARP input, int numHead, MNN_DATA_FORMAT format) {
+    std::unique_ptr<OpT> op(new OpT);
+    op->type = OpType_FmhaV2;
+    op->main.type = OpParameter_FmhaV2Param;
+    op->main.value = new FmhaV2ParamT;
+    op->main.AsFmhaV2Param()->heads = numHead;
+    op->defaultDimentionFormat = format;
+    return Variable::create(Expr::create(std::move(op), {input}));
+}
+
+bool runFmhaV2Case(int batch, int seqLen, int numHead, int headDim, bool packed) {
+    const int qkvWidth = numHead * 3 * headDim;
+    std::vector<float> inputData(batch * seqLen * qkvWidth);
+    for (int i = 0; i < static_cast<int>(inputData.size()); ++i) {
+        inputData[i] =
+            static_cast<float>((i * 17 + 11) % 37 - 18) * 0.071f + static_cast<float>((i * 7 + 3) % 13) * 0.013f;
+    }
+
+    auto input = _Input({batch, seqLen, qkvWidth}, NCHW, halide_type_of<float>());
+    ::memcpy(input->writeMap<float>(), inputData.data(), inputData.size() * sizeof(float));
+    input->unMap();
+    if (packed) {
+        input = _Convert(input, NC4HW4);
+    }
+
+    auto output = createFmhaV2(input, numHead, packed ? MNN_DATA_FORMAT_NC4HW4 : MNN_DATA_FORMAT_NCHW);
+    if (packed) {
+        output = _Convert(output, NCHW);
+    }
+    const float* outputPtr = output->readMap<float>();
+    if (outputPtr == nullptr) {
+        MNN_ERROR("FmhaV2Test failed to execute %s case.\n", packed ? "NC4HW4" : "NCHW");
+        return false;
+    }
+
+    const auto expected = referenceFmhaV2(inputData, batch, seqLen, numHead, headDim);
+    if (!checkVectorByRelativeError<float>(outputPtr, expected.data(), expected.size(), 0.0005f)) {
+        MNN_ERROR("FmhaV2Test %s mismatch: B=%d S=%d H=%d D=%d.\n", packed ? "NC4HW4" : "NCHW", batch, seqLen, numHead,
+                  headDim);
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+class FmhaV2Test : public MNNTestCase {
+public:
+    virtual ~FmhaV2Test() = default;
+
+    virtual bool run(int precision) {
+        return runFmhaV2Case(2, 3, 2, 2, false) && runFmhaV2Case(2, 5, 2, 3, true) && runFmhaV2Case(3, 1, 1, 5, true);
+    }
+};
+
+MNNTestSuiteRegister(FmhaV2Test, "op/fmha_v2");
+
+#endif // MNN_SUPPORT_TRANSFORMER_FUSE
