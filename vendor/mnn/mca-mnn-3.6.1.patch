+inline bool summarizeFloatTensor(const float* values,
+                                 size_t elementCount,
+                                 FloatTensorStats& stats,
+                                 std::string& error) {
+    stats = {};
+    error.clear();
+    if (values == nullptr) {
+        error = "null_tensor_data";
+        return false;
+    }
+    if (elementCount == 0) {
+        error = "empty_tensor";
+        return false;
+    }
+    stats.elementCount = elementCount;
+    constexpr uint64_t kFnvPrime64 = 1099511628211ULL;
+    double sum = 0.0;
+    double squareSum = 0.0;
+    bool hasFiniteValue = false;
+    for (size_t index = 0; index < elementCount; ++index) {
+        const float value = values[index];
+        uint32_t bits = 0;
+        static_assert(sizeof(bits) == sizeof(value), "float fingerprint assumes 32-bit float");
+        ::memcpy(&bits, &value, sizeof(bits));
+        for (int shift = 0; shift < 32; shift += 8) {
+            stats.fingerprint64 ^= static_cast<uint8_t>((bits >> shift) & 0xffU);
+            stats.fingerprint64 *= kFnvPrime64;
+        }
+        if (std::isnan(value)) {
+            ++stats.nanCount;
+            continue;
+        }
+        if (std::isinf(value)) {
+            ++stats.infinityCount;
+            continue;
+        }
+        if (!hasFiniteValue) {
+            stats.minimum = value;
+            stats.maximum = value;
+            hasFiniteValue = true;
+        } else {
+            stats.minimum = value < stats.minimum ? value : stats.minimum;
+            stats.maximum = value > stats.maximum ? value : stats.maximum;
+        }
+        if (value == 0.0f) {
+            ++stats.zeroCount;
+        }
+        ++stats.finiteCount;
+        sum += static_cast<double>(value);
+        squareSum += static_cast<double>(value) * static_cast<double>(value);
+    }
+    if (!hasFiniteValue) {
+        error = "tensor_has_no_finite_values";
+        return false;
+    }
+    stats.mean = sum / static_cast<double>(stats.finiteCount);
+    stats.rootMeanSquare = std::sqrt(squareSum / static_cast<double>(stats.finiteCount));
+    return true;
+}
+
+inline bool validateFloatTensorSignal(const FloatTensorStats& stats, std::string& error) {
+    error.clear();
+    if (stats.elementCount == 0) {
+        error = "empty_tensor";
+        return false;
+    }
+    if (stats.finiteCount != stats.elementCount || stats.nanCount != 0 || stats.infinityCount != 0) {
+        error = "tensor_contains_non_finite_values";
+        return false;
+    }
+    if (stats.zeroCount == stats.elementCount) {
+        error = "tensor_all_zero";
+        return false;
+    }
+    if (!std::isfinite(stats.mean) || !std::isfinite(stats.rootMeanSquare) ||
+        stats.rootMeanSquare <= 0.0) {
+        error = "tensor_summary_not_finite";
+        return false;
+    }
+    return true;
+}
