+// MNNChat's shipping Qwen visual path uses INTER_LINEAR. Keep that as the
+// source-equivalent baseline and allow an explicit bicubic A/B override.
+inline VisionResizeFilter qwenVisionResizeFilter(const std::string& requestedFilter) {
+    return requestedFilter == "bicubic"
+            ? VisionResizeFilter::Bicubic
+            : VisionResizeFilter::Linear;
+}
