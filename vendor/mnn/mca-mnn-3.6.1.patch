+inline bool validateInterpolationContract(const int* indices,
+                                          const float* weights,
+                                          size_t patchCount,
+                                          int positionEmbeddingCount,
+                                          InterpolationContractStats& stats,
+                                          std::string& error) {
+    stats = {};
+    error.clear();
+    if (indices == nullptr || weights == nullptr) {
+        error = "null_interpolation_data";
+        return false;
+    }
+    if (patchCount == 0 || positionEmbeddingCount <= 0) {
+        error = "invalid_interpolation_shape";
+        return false;
+    }
+    stats.minimumIndex = std::numeric_limits<int>::max();
+    stats.maximumIndex = std::numeric_limits<int>::min();
+    stats.minimumWeight = std::numeric_limits<float>::max();
+    stats.maximumWeight = std::numeric_limits<float>::lowest();
+    for (size_t patch = 0; patch < patchCount; ++patch) {
+        float weightSum = 0.0f;
+        for (size_t corner = 0; corner < 4; ++corner) {
+            const size_t offset = corner * patchCount + patch;
+            const int positionIndex = indices[offset];
+            const float weight = weights[offset];
+            if (positionIndex < 0 || positionIndex >= positionEmbeddingCount) {
+                error = "interpolation_index_out_of_range_at_" + std::to_string(offset);
+                return false;
+            }
+            if (!std::isfinite(weight) || weight < 0.0f || weight > 1.0f) {
+                error = "interpolation_weight_out_of_range_at_" + std::to_string(offset);
+                return false;
+            }
+            stats.minimumIndex = positionIndex < stats.minimumIndex ? positionIndex : stats.minimumIndex;
+            stats.maximumIndex = positionIndex > stats.maximumIndex ? positionIndex : stats.maximumIndex;
+            stats.minimumWeight = weight < stats.minimumWeight ? weight : stats.minimumWeight;
+            stats.maximumWeight = weight > stats.maximumWeight ? weight : stats.maximumWeight;
+            weightSum += weight;
+        }
+        const float weightSumError = std::fabs(weightSum - 1.0f);
+        stats.maximumWeightSumError = weightSumError > stats.maximumWeightSumError
+                ? weightSumError
+                : stats.maximumWeightSumError;
+    }
+    if (stats.maximumWeightSumError > 1.0e-4f) {
+        error = "interpolation_weight_sum_mismatch";
+        return false;
+    }
+    return true;
+}
