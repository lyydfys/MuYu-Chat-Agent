+inline std::size_t promptCacheReusableTokenPrefix(
+        const std::vector<int>& liveHistory,
+        std::size_t effectiveKvTokens,
+        const std::vector<int>& desiredPrompt) {
+    const std::size_t limit = std::min(
+            std::min(effectiveKvTokens, liveHistory.size()),
+            desiredPrompt.size());
+    std::size_t reusable = 0;
+    while (reusable < limit && liveHistory[reusable] == desiredPrompt[reusable]) {
+        ++reusable;
+    }
+    return reusable;
+}
+
+inline void trimPromptTokenHistory(std::vector<int>& history, std::size_t retainedTokens) {
+    // KV removal is lazy, but token history is trimmed immediately. Repeated
+    // suffix erasures therefore use an absolute boundary, never the KV delta.
+    history.resize(std::min(history.size(), retainedTokens));
+}
+
+inline std::size_t recurrentReusablePrefix(std::size_t tokenPrefix, std::size_t physicalTokens,
+        bool recurrentState, std::size_t checkpoint) {
+    if (!recurrentState || tokenPrefix >= physicalTokens) return tokenPrefix;
+    return checkpoint <= tokenPrefix ? checkpoint : 0;
+}
+
+inline std::vector<std::size_t> checkpointPrefillChunks(std::size_t tokens, std::size_t blockSize) {
+    const std::size_t prefix = tokens > 32 ? tokens - 32 : 0;
+    if (blockSize == 0) blockSize = tokens;
+    std::vector<std::size_t> chunks;
+    for (std::size_t start = 0; start < tokens;) {
+        const auto boundary = start < prefix ? prefix : tokens;
+        const auto count = std::min(blockSize, boundary - start);
+        chunks.push_back(count);
+        start += count;
+    }
+    return chunks;
+}
+
 }  // namespace Transformer
