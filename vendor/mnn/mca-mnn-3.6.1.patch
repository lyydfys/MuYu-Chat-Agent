+inline VisionInterpolationCornerMode qwenVisionInterpolationCornerMode(
+        const std::string& requestedMode) {
+    return requestedMode == "corrected"
+            ? VisionInterpolationCornerMode::Corrected
+            : VisionInterpolationCornerMode::MnnChatLegacy;
+}
