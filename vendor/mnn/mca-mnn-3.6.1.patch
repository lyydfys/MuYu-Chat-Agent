diff --git a/source/backend/cpu/CPUFmhaV2.cpp b/source/backend/cpu/CPUFmhaV2.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..8b03be4ef2be4fc858f106cd70b6434fa408067a
--- /dev/null
+++ b/source/backend/cpu/CPUFmhaV2.cpp
@@ -0,0 +1,187 @@
+//
+//  CPUFmhaV2.cpp
+//  MNN
+//
+//  Created by MNN on 2026/09/01.
+//  Copyright © 2018, Alibaba Group Holding Limited
+//
+
+#ifdef MNN_SUPPORT_TRANSFORMER_FUSE
+
+#include "CPUFmhaV2.hpp"
+#include "backend/cpu/CPUBackend.hpp"
+#include "backend/cpu/compute/CommonOptFunction.h"
+#include "core/Concurrency.h"
+#include "core/TensorUtils.hpp"
+#include "MNN_generated.h"
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace MNN {
+
+// FmhaV2 fuses a packed QKV projection and scaled dot-product attention. Its
+// logical input is [batch, seqLen, heads * 3 * headDim]. In NC4HW4, seqLen is
+// the packed C dimension, so one logical feature advances by four elements.
+
+CPUFmhaV2::CPUFmhaV2(Backend* backend, const MNN::Op* op) : Execution(backend) {
+    auto param = op->main_as_FmhaV2Param();
+    if (nullptr != param && param->heads() > 0) {
+        mNumHead = param->heads();
+    }
+}
+
+ErrorCode CPUFmhaV2::onResize(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs) {
+    if (inputs.size() != 1 || outputs.size() != 1 || inputs[0] == nullptr || outputs[0] == nullptr) {
+        return INPUT_DATA_ERROR;
+    }
+    auto input = inputs[0];
+    auto output = outputs[0];
+    auto core = static_cast<CPUBackend*>(backend())->functions();
+    if (core == nullptr || core->bytes != 4 || input->getType().code != halide_type_float ||
+        input->getType().bits != 32 || output->getType().code != halide_type_float || output->getType().bits != 32 ||
+        input->dimensions() != 3 || output->dimensions() != 3 || mNumHead <= 0) {
+        return NOT_SUPPORT;
+    }
+
+    mBatch = input->length(0);
+    mSeqLen = input->length(1);
+    mInputWidth = input->length(2);
+    if (mBatch <= 0 || mSeqLen <= 0 || mInputWidth <= 0 || mInputWidth % 3 != 0) {
+        return NOT_SUPPORT;
+    }
+    mOutputWidth = mInputWidth / 3;
+    if (mOutputWidth % mNumHead != 0 || output->length(0) != mBatch || output->length(1) != mSeqLen ||
+        output->length(2) != mOutputWidth) {
+        return NOT_SUPPORT;
+    }
+    mHeadDim = mOutputWidth / mNumHead;
+    if (mHeadDim <= 0) {
+        return NOT_SUPPORT;
+    }
+
+    const auto inputFormat = TensorUtils::getDescribe(input)->dimensionFormat;
+    const auto outputFormat = TensorUtils::getDescribe(output)->dimensionFormat;
+    if (inputFormat != outputFormat || (inputFormat != MNN_DATA_FORMAT_NCHW && inputFormat != MNN_DATA_FORMAT_NHWC &&
+                                        inputFormat != MNN_DATA_FORMAT_NC4HW4)) {
+        return NOT_SUPPORT;
+    }
+    mSequencePacked = inputFormat == MNN_DATA_FORMAT_NC4HW4;
+    if (!mSequencePacked &&
+        (input->stride(2) != 1 || input->stride(1) != mInputWidth || input->stride(0) != mSeqLen * mInputWidth ||
+         output->stride(2) != 1 || output->stride(1) != mOutputWidth || output->stride(0) != mSeqLen * mOutputWidth)) {
+        return NOT_SUPPORT;
+    }
+
+    mScale = 1.0f / std::sqrt(static_cast<float>(mHeadDim));
+    auto bn = static_cast<CPUBackend*>(backend());
+    if (mBatch > std::numeric_limits<int>::max() / mNumHead) {
+        return NOT_SUPPORT;
+    }
+    const int parallelNumber = mNumHead * mBatch;
+    const int threadNumber = ALIMIN(bn->threadNumber(), parallelNumber);
+    if (threadNumber < 1) {
+        return NOT_SUPPORT;
+    }
+    mScore.resize(static_cast<size_t>(threadNumber) * mSeqLen);
+    return NO_ERROR;
+}
+
+ErrorCode CPUFmhaV2::onExecute(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs) {
+    auto input = inputs[0];
+    auto output = outputs[0];
+    const int seq = mSeqLen;
+    const int batch = mBatch;
+    const int head = mNumHead;
+    const int dim = mHeadDim;
+    const float scale = mScale;
+    const float* inPtr = input->host<float>();
+    float* outPtr = output->host<float>();
+    if (inPtr == nullptr || outPtr == nullptr) {
+        return INPUT_DATA_ERROR;
+    }
+    if (mSequencePacked) {
+        const size_t packedOutputSize = static_cast<size_t>((seq + 3) / 4) * batch * mOutputWidth * 4;
+        std::fill(outPtr, outPtr + packedOutputSize, 0.0f);
+    }
+
+    const int featureStride = mSequencePacked ? 4 : 1;
+    const auto inputBase = [this, seq, batch](int b, int s) -> size_t {
+        if (mSequencePacked) {
+            // NC4HW4 packs the sequence/channel dimension inside each batch:
+            // [batch, ceil(seq/4), width, 4].  The previous sequence-major
+            // address mixed batches whenever batch > 1.
+            return (static_cast<size_t>(b) * ((seq + 3) / 4) + s / 4) *
+                    static_cast<size_t>(mInputWidth) * 4 + s % 4;
+        }
+        return (static_cast<size_t>(b) * seq + s) * mInputWidth;
+    };
+    const auto outputBase = [this, seq, batch](int b, int s) -> size_t {
+        if (mSequencePacked) {
+            return (static_cast<size_t>(b) * ((seq + 3) / 4) + s / 4) *
+                    static_cast<size_t>(mOutputWidth) * 4 + s % 4;
+        }
+        return (static_cast<size_t>(b) * seq + s) * mOutputWidth;
+    };
+    float* scoresBase = mScore.data();
+    auto bn = static_cast<CPUBackend*>(backend());
+    const int parallelNumber = head * batch;
+    const int threadNumber = ALIMIN(bn->threadNumber(), parallelNumber);
+
+    MNN_CONCURRENCY_BEGIN(tId, threadNumber) {
+        float* scores = scoresBase + tId * seq;
+        for (int task = tId; task < parallelNumber; task += threadNumber) {
+            const int b = task / head;
+            const int h = task % head;
+            const int qChunk = h * 3 * dim;
+            const int kChunk = h * 3 * dim + dim;
+            const int vChunk = h * 3 * dim + 2 * dim;
+            const int outH = h * dim;
+            for (int q = 0; q < seq; ++q) {
+                const float* qRow = inPtr + inputBase(b, q) + qChunk * featureStride;
+                float maxScore = -std::numeric_limits<float>::infinity();
+                for (int k = 0; k < seq; ++k) {
+                    const float* kRow = inPtr + inputBase(b, k) + kChunk * featureStride;
+                    float s = 0.0f;
+                    for (int d = 0; d < dim; ++d) {
+                        s += qRow[d * featureStride] * kRow[d * featureStride];
+                    }
+                    scores[k] = s * scale;
+                    if (scores[k] > maxScore) {
+                        maxScore = scores[k];
+                    }
+                }
+                float sum = 0.0f;
+                for (int k = 0; k < seq; ++k) {
+                    scores[k] = std::exp(scores[k] - maxScore);
+                    sum += scores[k];
+                }
+                const float invSum = 1.0f / sum;
+                float* outRow = outPtr + outputBase(b, q) + outH * featureStride;
+                for (int d = 0; d < dim; ++d) {
+                    float acc = 0.0f;
+                    for (int k = 0; k < seq; ++k) {
+                        acc += scores[k] * inPtr[inputBase(b, k) + (vChunk + d) * featureStride];
+                    }
+                    outRow[d * featureStride] = acc * invSum;
+                }
+            }
+        }
+    }
+    MNN_CONCURRENCY_END();
+    return NO_ERROR;
+}
+
+class CPUFmhaV2Creator : public CPUBackend::Creator {
+public:
+    virtual Execution* onCreate(const std::vector<Tensor*>& inputs, const std::vector<Tensor*>& outputs,
+                                const MNN::Op* op, Backend* backend) const override {
+        return new CPUFmhaV2(backend, op);
+    }
+};
+
+REGISTER_CPU_OP_CREATOR_TRANSFORMER(CPUFmhaV2Creator, OpType_FmhaV2);
+
+} // namespace MNN
+
+#endif /* MNN_SUPPORT_TRANSFORMER_FUSE */
