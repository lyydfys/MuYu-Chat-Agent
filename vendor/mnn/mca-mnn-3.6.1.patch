+inline bool validateMaterializedFloatTensorMatch(const FloatTensorStats& raw,
+                                                 const FloatTensorStats& materialized,
+                                                 std::string& error) {
+    error.clear();
+    if (raw.elementCount != materialized.elementCount) {
+        error = "materialized_tensor_element_count_mismatch";
+        return false;
+    }
+    if (raw.fingerprint64 != materialized.fingerprint64) {
+        error = "materialized_tensor_fingerprint_mismatch";
+        return false;
+    }
+    return true;
+}
