+static bool kleidiai_weight_type_supported(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_Q4_0:
+            return ctx.kernels_q4 != nullptr;
+        case GGML_TYPE_Q8_0:
+            return ctx.kernels_q8 != nullptr;
+        case GGML_TYPE_F32:
+            return ctx.kernels_f32 != nullptr;
+        default:
+            // K-quants, IQ quants, and all other weight formats have no
+            // KleidiAI packing/kernel path.  They must remain on the regular
+            // CPU backend even when their buffer happens to be a CPU_KLEIDIAI
+            // buffer allocated by an older graph planner.
+            return false;
+    }
+}
+
+static void kleidiai_warn_unsupported_weight_type(ggml_type type) {
+    if (!ggml_is_quantized(type) ||
+        type == GGML_TYPE_Q4_0 || type == GGML_TYPE_Q8_0) {
+        return;
+    }
+
+    static std::atomic<bool> warned(false);
+    if (!warned.exchange(true)) {
+        GGML_LOG_WARN("kleidiai: no kernel for tensor type %s, not accelerated by KleidiAI "
+                      "(kernels available for Q4_0 and Q8_0)\n",
+                      ggml_type_name(type));
+    }
+}
